# Copied to azerothcore-wotlk/.env by setup.sh. Edit values as desired.
# These feed the fork's docker-compose.yml.

# --- Database ---
# CHANGE THIS before exposing the server to anything but your trusted LAN. setup.sh REFUSES to
# run with PUBLIC_REALM_ADDRESS set while this is still the default. Use a long, unique value.
DOCKER_DB_ROOT_PASSWORD=changeme_db_password
# --- Published ports (host:container). Defaults match WoW 3.3.5a clients. ---
# Only AUTH (3724) and WORLD (8085) are ever published to the network. setup.sh's generated
# docker-compose.override.yml binds MySQL to 127.0.0.1 only and DROPS the SOAP port entirely,
# so DOCKER_SOAP_EXTERNAL_PORT / DOCKER_DB_EXTERNAL_PORT are effectively local-only now.
# NEVER port-forward 3306 (MySQL) or 7878 (SOAP) on your router.
DOCKER_AUTH_EXTERNAL_PORT=3724
DOCKER_WORLD_EXTERNAL_PORT=8085
DOCKER_SOAP_EXTERNAL_PORT=7878
DOCKER_DB_EXTERNAL_PORT=3306

# --- External access (let a friend play from outside your LAN) ---
# Leave BLANK for a LAN-only server (the default — realmlist points at your private IP).
# To expose: set this to your WAN public IP, or a DDNS hostname if your home IP is dynamic
# (resolved by the authserver at startup, so restart the stack after the IP behind it changes).
# Remote clients are handed this address; LAN clients still get the private IP automatically.
# Then on your Omada firewall: port-forward ONLY TCP 3724 + 8085 to this server, with an ACL
# restricting the source to your friend's static IP. See README "Exposing to a friend".
PUBLIC_REALM_ADDRESS=

# --- Realm LAN IP override ---
# Blank = autodetect from the default route (correct on a normal Linux host). On Windows/WSL2,
# set this to your WINDOWS HOST's LAN IP — WSL's autodetect returns the VM's internal NAT
# address (172.x), which LAN clients can't reach. The Windows installer
# (windows/Setup-AzerothCore.ps1) fills this in for you automatically.
LAN_IP=

# --- Container user (set automatically by setup.sh to the server user's id) ---
# Must match the host user so bind-mounted config/logs are writable.
DOCKER_USER_ID=1000
DOCKER_GROUP_ID=1000

# --- Image tag for the acore base images ---
DOCKER_IMAGE_TAG=master

# --- Server timezone ---
# IANA timezone name (e.g. America/Chicago, Europe/London) applied to the worldserver,
# db, and db-import containers via the TZ env var. This sets the in-game "server time"
# clock and all log timestamps; it also shifts when daily/weekly resets, Wintergrasp,
# and AHBot cycles land. Use an IANA name, NOT an abbreviation like "CST". Blank/unset
# falls back to Etc/UTC. NOTE: the nightly backup cron runs on the HOST clock, not this —
# set the host too with: sudo timedatectl set-timezone America/Chicago
SERVER_TZ=America/Chicago

# --- Bot population ---
# Total roaming bots kept online (spread across level brackets & both factions).
# ~MAX_RANDOM_BOTS / 20 bots per faction per level bracket. Higher = denser world,
# more CPU/RAM. 2000 is demanding — see README before pushing past it.
MAX_RANDOM_BOTS=500

# --- Gameplay rates ---
# Multipliers vs. Blizzlike (1 = retail rate). setup.sh writes these into worldserver.conf;
# changing one just needs a setup.sh re-run + worldserver restart (no rebuild). Defaults below
# are the boosted values this server ships with — omit a knob and you keep that default.
#
# XP gain, split by source. Usually moved together (set them all to the same number).
XP_KILL_RATE=3
XP_QUEST_RATE=3
XP_EXPLORE_RATE=3
XP_PET_RATE=3                     # XP earned by hunter/warlock pets
MONEY_DROP_RATE=2                # gold/silver dropped by mobs
REPUTATION_RATE=5                # faction reputation gain
HONOR_RATE=5                     # PvP/battleground honor points
# Rested-XP pool FILL speed (the blue "rested" bonus that doubles kill XP until spent), split
# by where you rest: logged in (InGame) vs logged off in a tavern/city vs out in the wilderness.
REST_INGAME_RATE=3
REST_OFFLINE_TAVERN_RATE=3
REST_OFFLINE_WILDERNESS_RATE=3

# --- Performance / hardware tuning (worldserver + playerbots threads) ---
# Throughput knobs. Defaults suit a mid-range host (roughly 4-8 cores) with a moderate-to-high
# bot count; scale them to your CPU and how many bots you run. Changing these just needs a
# re-run of setup.sh + a worldserver restart (no rebuild).
MAP_UPDATE_THREADS=8              # worldserver map-update threads — the biggest CPU lever with many
                                  # bots. One map = one thread's work and open-world bots live on ~5
                                  # continent maps, so past ~8 extra threads only serve instances.
CHAR_DB_WORKER_THREADS=4         # character-DB async workers — stock 1 funnels EVERY bot save
CHAR_DB_SYNCH_THREADS=4          # through one connection; the synch pool busy-spins when starved
PLAYERBOTS_DB_WORKER_THREADS=2   # bot-DB worker threads (stock 1 serializes all bot-event writes)
PLAYERBOTS_DB_SYNCH_THREADS=2    # bot-DB synch threads
BOT_ACTIVE_ALONE=10              # % of bots running full AI when no real player is near (lower =
                                  # cheaper; raise for a livelier empty world if you have CPU spare)
BOT_ACTIVE_ALONE_SMART_SCALE=1   # auto-throttle BotActiveAlone when the server tick gets heavy (1=on)
BOT_SMART_SCALE_CEILING=300      # world-tick ms at which SmartScale idles ALL alone-bots (stock 200;
                                  # higher keeps bots active at big populations at the cost of tick lag)
RANDOM_BOTS_PER_INTERVAL=150     # bots the random-bot manager logs in / maintains per ~20s cycle.
                                  # Stock 60 starves teleport/randomize maintenance past ~2000 bots;
                                  # world-thread work, so scale with bot count rather than maxing out.
VISIBILITY_DISTANCE_CONTINENTS=80 # unit/object draw distance on continents, GLOBAL (real players see
                                  # units pop in at this range too; terrain is client-side). Stock 100.
                                  # Visibility cost is O(visible-players^2) — the cheapest big CPU win.
PRELOAD_MAP_GRIDS=1              # pin all continent grids in RAM at boot (~9 GB). Grids never unload
                                  # in this fork, so wandering bots load them all eventually anyway —
                                  # preloading removes mid-tick grid file I/O. Set 0 on small hosts.

# --- Database performance (MySQL/MariaDB innodb tuning) ---
# Written to config/mysql-tuning.cnf and loaded LAST so it overrides the image defaults. Defaults
# assume the DB SHARES RAM with a bot-heavy worldserver, so the buffer pool is sized to the working
# set + headroom rather than the usual "50% of RAM" rule (which assumes a DEDICATED DB host and can
# OOM a shared box). Scale to your RAM (buffer pool) and disk speed (io capacity).
DB_BUFFER_POOL_SIZE=8G           # InnoDB buffer pool — the main RAM lever. On a shared box keep
                                  # well under total RAM; on a dedicated DB host it can go higher.
DB_BUFFER_POOL_INSTANCES=8       # split the pool into N instances (rule of thumb: keep each >=1GB)
DB_IO_CAPACITY=500               # baseline IOPS budget — raise for SSD/NVMe (e.g. 2000), lower for HDD
DB_IO_CAPACITY_MAX=2500          # burst IOPS ceiling — raise for SSD/NVMe
DB_FLUSH_LOG_AT_TRX_COMMIT=2     # 2 = fsync the redo log ~once/second instead of every commit — the
                                  # right trade under thousands of bot saves (a HOST crash can lose
                                  # up to ~1s of writes; a mysqld-only crash loses nothing). 1 = full
                                  # ACID durability at a large fsync cost.

# --- Quality-of-life tweaks ---
# Free Dual Talent Specialization: removes the 1000g trainer cost (still requires
# level 40 + a class trainer). 1 = free, 0 = retail 1000g cost. Re-applied to the
# world DB on every setup run, so it survives rebuilds and a full world-DB re-import.
FREE_DUAL_SPEC=1

# Molten Core rune dousing: removes the 1-hour cooldown on Eternal Quintessence
# (item 22754) so you can douse all 7 Runes of Warding back-to-back to reach
# Majordomo. 1 = no cooldown, 0 = retail 1-hour cooldown. Re-applied to the world
# DB on every setup run, so it survives rebuilds and a full world-DB re-import.
MC_DOUSE_NO_COOLDOWN=1

# Darkmoon Faire continuous rotation: instead of ~1 week per month with a ~3-week
# gap, the Faire is always up somewhere and moves weekly — Elwynn -> Mulgore ->
# Terokkar, 1 week each on a 21-day cycle, no downtime. 1 = continuous, 0 = retail
# monthly cadence. Re-applied to the world DB on every setup run, so it survives
# rebuilds and a full world-DB re-import. NOTE: the in-game Calendar won't show it
# (that comes from client-side Holidays.dbc, which we don't patch) — the Faire is
# still fully present in-world.
DARKMOON_CONTINUOUS=1

# "Stave of the Ancients" fast respawn: the four demonic corrupters for the mage
# quest (7636) appear as neutral "disguise" NPCs (Simone the Inconspicuous, Franklin
# the Friendly, Artorius the Amiable, Nelson the Nice) that turn hostile when talked
# to. Fail the solo fight and they despawn for 10-15 min. 1 = respawn in 30s so you
# can retry quickly, 0 = retail 600s/900s timers. Re-applied to the world DB on every
# setup run, so it survives rebuilds and a full world-DB re-import.
STAVE_FAST_RESPAWN=1

# How much bots talk in chat. Tunes the base playerbots canned channel broadcasts
# (loot/kill/quest spam in World/General/Trade/LFG).
#   off    = no ambient or bot-to-bot chatter; bots still reply when YOU talk to them
#   low    = some flavor, ~90% less channel spam
#   mild   = a notch above low; a bit more ambient + bot-to-bot, still far below normal (default)
#   normal = stock module defaults (very chatty)
# Bots always answer a real player regardless of this setting.
BOT_CHATTER=mild

# --- Backups (nightly mysqldump cron, installed by setup.sh) ---
# setup.sh installs a cron that runs ./backup.sh (gzipped dump of all DBs to ./backups/).
# BACKUP_CRON=0 skips installing the cron (run ./backup.sh manually instead).
# BACKUP_SCHEDULE is standard cron syntax — MUST be quoted (contains spaces).
# BACKUP_KEEP is how many timestamped dumps to retain.
# NOTE: the cron fires on the HOST clock, not SERVER_TZ.
BACKUP_CRON=1
BACKUP_SCHEDULE="0 4 * * *"
BACKUP_KEEP=14

# --- Auction house economy (mod-ah-bot-plus) ---
# GUID(s) of a dedicated, NORMAL (non-playerbot) character the AH bot operates as.
# Leave blank to keep AHBot off. Comma-separate for multiple (e.g. 3,4).
# Find a GUID after creating the character:
#   SELECT guid,name FROM acore_characters.characters WHERE name='YourAHChar';
AHBOT_GUIDS=

# Enable the AHPrice lookup tool (.ahprice command + AHPrice client addon), which
# shows the buy-value range the AH bot will pay for an item. 1 = on, blank/0 = off.
# Independent of AHBOT_GUIDS — it just previews the pricing formula.
AHPRICE_ENABLE=

# AHPrice: hide items that can't be auctioned from search results (soulbound/quest-bound,
# conjured, and limited-duration items — the bot never buys them). 1 = hide (default),
# 0 = show them. Blank keeps default.
AHPRICE_HIDE_UNAUCTIONABLE=

# --- Registration website (ac-webreg) ---
# A small Go service for friends to register/login/change-password, plus a client
# download. Runs as another container in this stack, published on the LAN only. For LAN use
# browse to http://<this-host-LAN-ip>:<WEBREG_LAN_PORT>; to expose it externally put it behind
# a reverse proxy or tunnel (e.g. Cloudflare Tunnel, nginx+TLS) rather than WAN-forwarding the
# raw port. Leave WEBREG_ADMIN_PASS blank to keep the site OFF (setup.sh skips the service).
WEBREG_ADMIN_PASS=
WEBREG_ADMIN_USER=admin
# Display name shown on the registration site's landing page (browser title + heading).
# Quote it if it contains spaces — this file is also sourced by setup.sh/backup.sh.
WEBREG_SITE_NAME="WoW Server"
# Host LAN bind port the service listens on (and that your reverse proxy/tunnel points at).
WEBREG_LAN_PORT=8090
# Path on THIS host to the client zip you prepared (bind-mounted read-only into the
# container). Leave blank to hide the download button.
CLIENT_ZIP_PATH=./client-dist/wow-335a.zip
# Quote any value containing spaces — this file is also sourced by setup.sh/backup.sh.
CLIENT_ZIP_LABEL="Download WoW 3.3.5a client + addons"
# The admin account list hides playerbot accounts whose username starts with this
# prefix. Must match playerbots' AiPlayerbot.RandomBotAccountPrefix (default rndbot).
WEBREG_BOT_PREFIX=rndbot
# Autogenerated by setup.sh if left blank — no need to set these by hand.
WEBREG_SESSION_SECRET=
WEBREG_DB_PASS=

# ── Ollama host (shared by AI bot chat + lore sidecar) ───────────────────────
# IP or hostname of the machine running Ollama. Used to build CHATTER_URL and reached
# directly by the lore sidecar. Default host.docker.internal = this Docker host itself;
# set it to your GPU box's LAN IP if Ollama runs on a different machine. Only matters when
# CHATTER_ENABLE=1 or LORE_ENABLE=1 — and remember to `ollama pull` your model first.
OLLAMA_IP=host.docker.internal

# ── AI bot chat (mod-playerbot-chatter) ──────────────────────────────────────
# Two Ollama-driven layers: REACTIVE replies to player whispers / party-raid /
# proximity-say, and AMBIENT self-initiated chatter in General / party-raid / guild
# (replaces playerbots' canned broadcasts). Does NOT touch playerbot/MultiBot commands.
# When enabled, playerbots' RandomBotTalk + EnableBroadcasts + RandomBotSayWithoutMaster
# are pinned OFF so this mod owns the entire bot voice.
# Master switch — turns on BOTH layers (ambient follows this unless CHATTER_AMBIENT_ENABLE is set).
CHATTER_ENABLE=0
# Ollama endpoint. Defaults to http://${OLLAMA_IP}:11434/api/generate if OLLAMA_IP is set.
#CHATTER_URL=http://10.0.0.5:11434/api/generate
# Pick a model your Ollama GPU can run. llama3.1:8b (~5.5GB at Q4) gives solid WoW knowledge +
# tool calling and runs well on an 8GB card; ~4B models know the game noticeably less well.
CHATTER_MODEL=llama3.1:8b
# CHATTER_THINK only matters for reasoning models (e.g. qwen3): 0 sends think=false. Harmless
# for llama3.1.
CHATTER_THINK=0
# Parallel Ollama requests. On an 8GB GPU with an 8B model, 2-3 is safe; lower if VRAM is tight.
CHATTER_MAX_CONCURRENT=3
# Fan-out: ambient say and un-named group chat -> random N nearby/grouped bots, chance-rolled.
CHATTER_SAY_RANGE=40
CHATTER_SAY_MAX_BOTS=2
CHATTER_SAY_CHANCE=35
CHATTER_GROUP_MAX_BOTS=2
CHATTER_GROUP_CHANCE=50
# Force at least one party/raid bot to answer when you address the group (1=on).
CHATTER_GROUP_GUARANTEE_ONE=1
CHATTER_WHISPER_CHANCE=100
CHATTER_HISTORY_LEN=10
CHATTER_REPLY_MAXLEN=200
# Override the bot persona / system prompt (shared by both layers). Leave unset to use the
# built-in WotLK-grounded "real person playing the game" prompt. Must be a single quoted line.
#CHATTER_SYSTEM_PROMPT="You're a real person playing WoW 3.3.5a, chatting in-game. Keep it short and casual."
# Few-shot STYLE example lines (real-player chat) fed to the model as tone/length anchors on
# both the ambient and reactive paths. Defaults to the file shipped with the mod (bind-mounted
# read-only at /azerothcore/modules); edit that file + restart ac-worldserver to tune, no rebuild.
# Point this elsewhere to swap in your own captured/cleaned chat log. Empty file -> built-in list.
#CHATTER_STYLE_EXAMPLES_FILE=/azerothcore/modules/mod-playerbot-chatter/data/style-examples.txt
#
# ── Ambient (self-initiated) chatter ─────────────────────────────────────────
# Bots open and carry conversations on their own in any channel that holds a real
# player (empty channels cost zero GPU). All optional — values shown are the built-in
# defaults; uncomment to tune. Ambient turns on automatically with CHATTER_ENABLE=1.
#CHATTER_AMBIENT_ENABLE=1            # defaults to CHATTER_ENABLE
#CHATTER_AMBIENT_GENERAL=1           # speak in a zone's General channel
#CHATTER_AMBIENT_GROUP=1             # speak in party/raid
#CHATTER_AMBIENT_GUILD=1             # speak in guild chat
# Cadence (seconds): slow "seed" opens a topic, fast "follow-up" carries a burst.
#CHATTER_AMBIENT_SEED_MIN=60
#CHATTER_AMBIENT_SEED_MAX=90
#CHATTER_AMBIENT_FOLLOWUP_MIN=4
#CHATTER_AMBIENT_FOLLOWUP_MAX=9
#CHATTER_AMBIENT_ACTIVE_WINDOW=75    # a context stays "active" this long after the last line
# Bot-to-bot brakes: cap consecutive bot lines, then cool the thread down.
#CHATTER_AMBIENT_BOT_STREAK_MAX=4
#CHATTER_AMBIENT_COOLDOWN=75         # thread cooldown (s) after hitting the streak cap
#CHATTER_AMBIENT_PER_BOT_COOLDOWN=120 # min gap (s) between one bot's ambient lines
#CHATTER_AMBIENT_MAX_PER_MIN=25      # global ambient messages/min ceiling (raise=livelier, lower if GPU-bound)
#CHATTER_AMBIENT_BUFFER_LEN=8        # recent lines kept per context for "react" mode
# Content mix (relative weights). Banter (social/community/takes/off-topic) is highest so bots
# hang out instead of narrating what they're doing; Flavor ("what I'm doing now") is nearly off.
# React stays high so bots answer each other once a channel is active. Raise W_BANTER to push
# social chatter even harder (live-editable in the conf too — no rebuild).
#CHATTER_AMBIENT_W_BANTER=40         # social banter / game-design takes / light off-topic
#CHATTER_AMBIENT_W_GENERIC=10        # in-game "what I'm doing" small talk (demoted)
#CHATTER_AMBIENT_W_REACT=35
#CHATTER_AMBIENT_W_FLAVOR=3          # remark on current activity (nearly off)
#CHATTER_AMBIENT_W_EVENT=8           # ding / quest / boss-kill riffs (loot riff was removed)

# ── Lore sidecar (mod-playerbot-chatter Tier-2: factual Q&A) ──────────────────
# When 1, the ac-lore Python sidecar is built/started and the worldserver routes
# whispered factual questions ("where's the nearest trainer?") to it. Answers come
# from real game data; on any miss the bot falls back to a normal reply. Builds on
# the reactive chatter layer, so it also needs CHATTER_ENABLE=1 (above) and OLLAMA_IP
# set (the sidecar calls the same Ollama as the chatter module).
LORE_ENABLE=0
LORE_PORT=8091
LORE_MODEL=llama3.1:8b
# LORE_TIMEOUT = worldserver's total wait for the sidecar (covers both model calls);
# LORE_GEN_TIMEOUT = the sidecar's per-Ollama-call ceiling. Raise both if the GPU is slow
LORE_TIMEOUT=60
LORE_GEN_TIMEOUT=60
# Verbose request/reply logging from the sidecar (1=on).
LORE_DEBUG=0
# Autogenerated by setup.sh if left blank (read-only 'lore' MySQL user) — no need to set.
LORE_DB_PASS=

# ── Raid roster (mod-raid-roster) ────────────────────────────────────────────
# A persistent, named raid roster you fully control: pin 40 bots once
# (.raidroster create), bring a role-balanced subset online that auto-forms a
# raid (.raidroster login 5|10|25|40), and level + gear them to your character
# while locking each one's tank/heal/dps role (.raidroster sync). Built on top
# of mod-playerbots' "addclass" bots. The four knobs below only take effect when
# RAIDROSTER_ENABLE=1 (setup.sh leaves playerbots untouched while it's 0).
#
# RAIDROSTER_ENABLE
#   Master switch for the module. 0 = off (commands reply "disabled"), 1 = on.
#   Changing this needs a setup.sh run + restart. Default 0.
RAIDROSTER_ENABLE=0
#
# ADDCLASS_POOL_SIZE  ->  AiPlayerbot.AddClassAccountPoolSize
#   How many dedicated "addclass" bot characters mod-playerbots pre-creates to
#   draw your roster from. The roster needs up to 5 of a single class, so this
#   must be comfortably large; 50 is the playerbots default and is plenty.
#   Raising it requires a restart so the new characters get generated.
ADDCLASS_POOL_SIZE=50
#
# GEAR_MATCH_RATIO  ->  AiPlayerbot.AutoInitEquipLevelLimitRatio
#   How closely .raidroster sync (and the built-in init=auto) match bot gear to
#   YOUR gear. 1.0 = aim for your gear score (the fix for "bots come out
#   overpowered"). Below 1.0 keeps them a notch under you (e.g. 0.9 ~ 10% lower);
#   above 1.0 lets them out-gear you. Live-tunable (no rebuild), takes effect on
#   the next sync.
GEAR_MATCH_RATIO=1.0
#
# MAX_ADDED_BOTS  ->  AiPlayerbot.MaxAddedBots
#   Hard cap on how many bots you can control at once. A 40-man raid fields 39
#   bots (you are the 40th member, MAXRAIDSIZE=40); 60 leaves headroom for that
#   plus any bots you add manually. Don't set below 39 or full raids won't fill.
#   (core default: 40)
MAX_ADDED_BOTS=60

# ── Wintergrasp bots (mod-wintergrasp-bots) ──────────────────────────────────
# Makes playerbots join Wintergrasp battles so a solo player has enemies to
# fight and can rank up. Built always; the director stays inert while ENABLE=0.
# Changing these needs a setup.sh run + worldserver restart.
#
# WGBOTS_ENABLE — master switch. 0 = off (no bots pulled into WG), 1 = on.
WGBOTS_ENABLE=0
# WGBOTS_PER_FACTION — target bot count to keep per faction during a battle.
WGBOTS_PER_FACTION=15
# WGBOTS_MIN_LEVEL — minimum bot level to be eligible (WG core minimum is 75).
WGBOTS_MIN_LEVEL=75
# WGBOTS_TICK_MS — how often (ms) the director reconciles population.
WGBOTS_TICK_MS=5000
# WGBOTS_DEBUG — 1 logs each director decision to the worldserver console.
WGBOTS_DEBUG=0
# WGBOTS_WORKSHOP_CAPTURE — 1 = bots pursue objectives (capture workshops + role-position);
#   0 = Phase 2a behavior (hold + brawl only).
WGBOTS_WORKSHOP_CAPTURE=1
# WGBOTS_ARRIVE_RADIUS — yards; within this of its objective a bot stops and holds.
WGBOTS_ARRIVE_RADIUS=8.0
# WGBOTS_STUCK_SECONDS — seconds of no progress (traveling, not in combat) before a stuck
#   bot is teleported to its objective (the only teleport path).
WGBOTS_STUCK_SECONDS=12
# WGBOTS_STUCK_EPSILON — yards of movement below which a sample counts as "no progress".
WGBOTS_STUCK_EPSILON=3.0
# WGBOTS_REASSERT_MOVE — 1 re-issues MovePoint each tick for idle bots (recommended).
WGBOTS_REASSERT_MOVE=1
# WGBOTS_ENGAGE_VEHICLE_RADIUS — yards: idle bots attack a hostile siege vehicle this close (0 = off).
WGBOTS_ENGAGE_VEHICLE_RADIUS=80
# WGBOTS_DEFENSE_SHARE — % of defenders massed at the keep defense line while enemy siege exists.
WGBOTS_DEFENSE_SHARE=60
# WGBOTS_FIELD_GARRISON — 1 spawns faction guard squads at workshops + bridge roads (rank fodder; core omits them).
WGBOTS_FIELD_GARRISON=1
# WGBOTS_TURRET_CREW_MAX — max defenders manning keep tower cannons (threat-gated crews).
WGBOTS_TURRET_CREW_MAX=4
# WGBOTS_RALLY_PER_VEHICLE — defenders sent to the rally per enemy vehicle near the keep.
WGBOTS_RALLY_PER_VEHICLE=3
# WGBOTS_THREAT_RADIUS — yards from the keep gate within which enemy vehicles are a keep threat.
WGBOTS_THREAT_RADIUS=350
# WGBOTS_PATROL_RADIUS — yards: patrol-loop radius at held objectives (0 = statues).
WGBOTS_PATROL_RADIUS=12
# WGBOTS_SORTIE_QUORUM — defenders mustered inside the keep before the rally wave sorties (0 = off).
WGBOTS_SORTIE_QUORUM=4
# WGBOTS_CAPTURE_SQUAD — attackers per enemy-workshop capture squad post-rank-phase (+2 at zero owned workshops).
WGBOTS_CAPTURE_SQUAD=5
# WGBOTS_SIEGE_ENABLE — 1 = attacker bots build + pilot demolishers to break the keep (Phase 3).
WGBOTS_SIEGE_ENABLE=1
# WGBOTS_SIEGE_HUMAN_RESERVE — vehicle slots per faction reserved for human players.
WGBOTS_SIEGE_HUMAN_RESERVE=2
# WGBOTS_RECREW_RADIUS — yards: an attacker foot bot re-crews an idle friendly siege vehicle this close (0 = off).
WGBOTS_RECREW_RADIUS=40
# WGBOTS_VEHICLE_REAP_SECONDS — seconds an unmanned, unreachable siege vehicle survives before being killed to free the cap (0 = off).
WGBOTS_VEHICLE_REAP_SECONDS=30
# WGBOTS_KEEP_SCREEN — attackers screening the keep gate when no siege vehicle is in play (the rest push workshops).
WGBOTS_KEEP_SCREEN=4

# ── Arena roster (mod-arena-roster) ──────────────────────────────────────────
# Arena roster: per-player arena partner bots + premade tiered opponent teams + arena AI.
# 1 = enable (.arenaroster create/go/sync in-game; .arenaroster poolinit once). Default off.
ARENAROSTER_ENABLE=0

# ── Individual Progression (mod-individual-progression) ──────────────────────
# Per-character era progression (Vanilla→TBC→WotLK). Gates content/gear/difficulty/world/
# professions/PvP by a per-character progression stage. Applied over the EXISTING realm; set
# each existing character's era by level band by hand after first boot (≤60 Vanilla, 61-70 TBC,
# 71-80 WotLK) via the GM command `.ip set <player> <stage>` (stages: 0 Vanilla / 8 TBC / 13 WotLK).
# Every key below maps 1:1 to an IndividualProgression.* conf option or an optional zz_optional_*.sql
# file. Defaults target "authentic to each era" while keeping the bot ecosystem working. Conf keys
# are live-config (edit + restart); the optional-SQL and client-patch flags need a rebuild/re-import.
IP_ENABLE=1

# --- Difficulty / scaling ---
IP_VANILLA_POWER_ADJ=1            # VanillaPowerAdjustment
IP_VANILLA_HEALING_ADJ=1          # VanillaHealingAdjustment
IP_TBC_POWER_ADJ=1                # TBCPowerAdjustment
IP_TBC_HEALING_ADJ=1              # TBCHealingAdjustment
IP_BOT_ONLY_ADJUSTMENTS=0         # BotOnlyAdjustments (1 = scale bots only, not players)

# --- Grouping / bots ---
# EnforceGroupRules=0 by DESIGN: bots do no quests so their derived era is always Vanilla; with
# it ON every un-synced bot becomes ungroupable for a TBC/WotLK player. .raidroster sync still
# aligns ROSTER bots' era. Flip to 1 only if you want strict cross-tier blocking.
IP_ENFORCE_GROUP_RULES=0          # EnforceGroupRules
IP_BOT_ACCOUNTS_REGEX=^RNDBOT.*   # BotAccountsRegex — MUST match our bot accounts (verify at runtime)
IP_BOT_ACCOUNTS_MAX_LEVEL=80      # BotAccountsMaxLevel
IP_EXCLUDED_ACCOUNTS_REGEX=       # ExcludedAccountsRegex (accounts exempt from IP)

# --- Gating / unlocks ---
IP_DISABLE_RDF=0                  # DisableRDF — keep Dungeon Finder (roster + DK-LFG rely on it)
IP_STARTING_PROGRESSION=0         # StartingProgression (new chars start Vanilla)
IP_PROGRESSION_LIMIT=0            # ProgressionLimit (0 = no cap)
# 1 = expansion changes are a PLAYER CHOICE: IP stages 8 (TBC) and 13 (WotLK) are held against
# automatic advance (patch 0027, ManualAdvanceStates="8 13"); once eligible (Kel'Thuzad-40 down /
# Kil'jaeden achievement) the player talks to Anduin (Alliance) or Thrall (Horde) and confirms a
# warning popup. Needed because an era change WIPES era talents. 0 = stock automatic progression.
IP_MANUAL_ERA_ADVANCE=1
IP_DK_UNLOCK_STAGE=13             # DeathKnightUnlockProgression (DKs gated to WotLK)
IP_DK_START_STAGE=13              # DeathKnightStartingProgression
IP_TBC_RACES_UNLOCK=8             # TbcRacesUnlockProgression (Draenei/BE gated to TBC)
IP_TBC_RACES_START=8              # tbcRacesStartingProgression
IP_REQUIRE_NAXX_STRATH=0          # RequireNaxxStrathEntrance
IP_FISHING_FIX=1                  # FishingFix
IP_DISABLE_QUEST_MARKERS=1        # DisableQuestMarkers
IP_MAX_MONSTER_SIGHT=1            # MaxMonsterSight
IP_QUEST_XP_FIX=1                 # QuestXPFix

# --- Optional SQL files (zz_optional_*.sql). Changing one needs a DB re-import (setup.sh rebuild).
IP_OPT_SPELL_DMG_HEALING=1        # zz_optional_spell_damage_and_healing.sql  (restore magical +heal/+dmg on vanilla/TBC items)
IP_OPT_CREATURE_STATS=1           # zz_optional_creature_stats.sql
IP_OPT_VANILLA_REGEN=1            # zz_optional_vanilla_regen_values.sql
IP_OPT_ITEM_STACK_SIZES=1         # zz_optional_item_stack_sizes.sql
IP_OPT_AMMO_STACK=1               # zz_optional_ammo_stack_size.sql
IP_OPT_VANILLA_MODELS=1           # zz_optional_vanilla_models.sql
IP_OPT_PHASING=1                  # zz_optional_phasing.sql
IP_OPT_REMOVE_HEIRLOOMS=1         # zz_optional_remove_heirlooms.sql
IP_OPT_VANILLA_CRAFTING=1         # zz_optional_vanilla_crafting_requirements.sql (needs dbc.7z server DBCs)
IP_OPT_CRAFTING_CD=1              # zz_optional_restore_crafting_cd_timers.sql
IP_OPT_POTION_CD=1                # zz_optional_restore_potion_cd.sql
IP_OPT_ROGUE_POISONS=1            # zz_optional_restore_rogue_poisons.sql (needs dbc.7z server DBCs)
IP_OPT_LIMIT_SPELLS=1             # zz_optional_limit_spells_to_expansion.sql
IP_OPT_VANILLA_TRANSPORTS=1       # zz_optional_vanilla_transports.sql
IP_OPT_SMALL_GROUP_ADJ=1          # zz_optional_small_group_adjustments.sql (important for bot/small groups)
IP_OPT_UNOBTAINABLE_ITEMS=0       # zz_optional_unobtainable_items.sql (adds TCG/promo drops)
IP_OPT_WOTLK_HP_FOR_TBC_RAIDS=0   # zz_optional_wotlk_hp_values_for_tbc_raids.sql (OFF: alters Sunwell HP, see raid audit)
IP_OPT_AQ_QUEST_NERF=0            # zz_optional_aq_quest_nerf.sql
IP_OPT_AV_LANDMINES=0             # zz_optional_av_landmines.sql
IP_OPT_TBC_HEROIC_KEYS_NERF=0     # zz_optional_tbc_heroic_dungeon_keys_nerf.sql
IP_OPT_TBC_PVP_PRICES=0           # zz_optional_tbc_pvp_prices.sql
IP_OPT_STACKABLE_BUFF_SCROLLS=0   # zz_optional_stackable_buff_scrolls.sql

# --- Bot riding levels (era-align playerbots to IP's trainer gating) ---
# IP restores original riding REQUIREMENTS via trainer_spell.ReqLevel (Apprentice 40, Journeyman
# 60, Expert/flying 70 — see mounts_and_riding.sql). Real players are gated at the trainer, but
# bots never visit trainers: PlayerbotFactory grants the riding spells directly and CheckMountState
# gates USE, both keyed off AiPlayerbot.Use*MountAtMinLevel (stock WotLK 20/40/60/70) — so bots
# ride at 20 under IP. These knobs (applied by setup.sh ONLY when IP_ENABLE=1) set those thresholds
# to the era values so bots learn+use each tier at the same level a player can train it. With
# IP_ENABLE=0 the stock WotLK defaults are left untouched. Values must match the ReqLevels above.
IP_BOT_GROUND_MOUNT_LEVEL=40      # AiPlayerbot.UseGroundMountAtMinLevel     (60% ground, spell 33388)
IP_BOT_FAST_GROUND_MOUNT_LEVEL=60 # AiPlayerbot.UseFastGroundMountAtMinLevel (100% ground, spell 33391)
IP_BOT_FLY_MOUNT_LEVEL=70         # AiPlayerbot.UseFlyMountAtMinLevel        (150% flying, spell 34090)
IP_BOT_FAST_FLY_MOUNT_LEVEL=70    # AiPlayerbot.UseFastFlyMountAtMinLevel    (280% flying, spell 34091)

# --- Client patch (staged by fetch-client-addons.sh) + server-side DBC overlay (setup.sh) ---
# patch-V ships BOTH a client patch-V.mpq (players drop into WoW Data/) AND a server Spell.dbc
# (setup.sh overlays it into the worldserver). dbc.7z ships the server profession DBCs; its only
# client files are cosmetic (skipped). Turning these on makes era mana costs / vanilla professions
# real server-side, not just client display.
IP_CLIENT_PATCH_V=1               # patch-V — era mana costs (client patch-V.mpq + server Spell.dbc)
IP_CLIENT_DBC=1                   # dbc.7z — server-side profession/recipe DBCs

# ── Era Talents (mod-era-talents) ────────────────────────────────────────────
# Authentic Vanilla/TBC talent trees for era-gated chars (all nine original classes).
# Talents reuse a stock WotLK passive where it matches the era, and otherwise ship their
# own server-side spells in a reserved id band (restored abilities, procs, per-rank
# passives) — stock spell ids are never modified. The EraTalents client addon
# (client-addons-src/EraTalents/, auto-staged) replaces the Blizzard talent frame in
# Vanilla/TBC eras; WotLK-era chars keep the stock frame. See README "Era talents" +
# docs/era-talents-classes.md.
# Requires IP_ENABLE=1 — eras come from Individual Progression (setup.sh forces this
# OFF if IP is disabled).
ERATALENTS_ENABLE=1
ERATALENTS_DEBUG=0                # 1 = log each ERATAL request/reply + reconcile to the worldserver console
ERATALENTS_BOTS=0                 # 1 = bots in the Vanilla (1-60) / TBC (61-70) level bands use era talent builds
# Glyphs are WotLK-only: block+strip glyphs for Vanilla/TBC-era characters (players AND
# bots; DKs exempt). 1 = on (default), 0 = leave glyphs alone.
ERATALENTS_GLYPHGATE=1
