+bool KjQuarantineFireBloomAction::Execute(Event /*event*/)
+{
+    float const outward = bot->GetExactDist2d(KJ_ANCHOR_X, KJ_ANCHOR_Y);
+
+    if (!botAI->CanMove())
+    {
