+// 41926 - Hateful Strike (Naxx40 Patchwerk only)
+// The boss passes its damage as a custom base point, but the core still adds the spell's
+// 1..4501 die roll on top, so a 17680-18280 strike landed for 17680-22780. Drop the roll.
+class spell_patchwerk_hateful_strike_40 : public SpellScript
+{
+    PrepareSpellScript(spell_patchwerk_hateful_strike_40);
+
+    void CalculateDamage(SpellEffIndex /*effIndex*/)
+    {
+        Unit* caster = GetCaster();
+        if (!caster || caster->GetEntry() != NPC_PATCHWERK_40)
+        {
+            return;
+        }
+        // SetSpellValue stored the boss's value minus 1 (CalcBaseValue) for a spell with die sides.
+        SetEffectValue(GetSpellValue()->EffectBasePoints[EFFECT_0] + 1);
+    }
+
+    void Register() override
+    {
+        OnEffectLaunchTarget += SpellEffectFn(spell_patchwerk_hateful_strike_40::CalculateDamage, EFFECT_0, SPELL_EFFECT_SCHOOL_DAMAGE);
+    }
+};
+
 void AddSC_boss_patchwerk_40()
 {
     new boss_patchwerk_40();
+    RegisterSpellScript(spell_patchwerk_hateful_strike_40);
 }
