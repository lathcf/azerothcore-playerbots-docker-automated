@@ -0,0 +1,63 @@
+// Ai/Base/Actions/BgPriorityActions.cpp
+#include "BgPriorityActions.h"
+#include "BattlegroundBotsApi.h"
+#include "Player.h"
+#include "PlayerbotAI.h"
+#include "Playerbots.h"
+#include "Timer.h"
+
+// The live-BG gate is the single InLiveOpenWorldBg() in BgKillTargetValue.h (pulled in by
+// BgPriorityActions.h) — it is stricter than InBattleground() && !InArena() because it also
+// requires STATUS_IN_PROGRESS, matching the values these actions read.
+
+bool AttackBgPriorityTargetAction::isUseful() { return InLiveOpenWorldBg(bot) && BattlegroundBotsApi::Enabled(); }
+
+bool AttackBgPriorityTargetAction::Execute(Event /*event*/)
+{
+    uint32 now = getMSTime();
+    if (now - _lastSwitchMs < BattlegroundBotsApi::Knobs().retargetCooldownMs) return false;
+    Unit* target = AI_VALUE(Unit*, "bg kill target");
+    if (!target || bot->GetVictim() == target) return false;
+    if (!Attack(target)) return false;
+    _lastSwitchMs = now;
+    return true;
+}
+
+bool BgPeelForAllyAction::isUseful()
+{
+    return InLiveOpenWorldBg(bot) && BattlegroundBotsApi::Enabled()
+        && (PlayerbotAI::IsTank(bot, true) || PlayerbotAI::IsMelee(bot, true));
+}
+
+bool BgPeelForAllyAction::Execute(Event /*event*/)
+{
+    uint32 now = getMSTime();
+    if (now - _lastPeelMs < BattlegroundBotsApi::Knobs().retargetCooldownMs) return false;
+    Unit* target = AI_VALUE(Unit*, "bg peel target");
+    if (!target) return false;
+    static char const* const kPeels[] = { "hamstring", "frost shock", "concussive shot", "earthbind totem",
+                                          "hammer of justice", "intimidating shout", "death grip" };
+    bool cast = false;
+    for (char const* name : kPeels)
+        if (botAI->CanCastSpell(name, target)) { cast = botAI->CastSpell(name, target); if (cast) break; }
+    bool switched = bot->GetVictim() != target && Attack(target);
+    if (!cast && !switched) return false;
+    _lastPeelMs = now;
+    return true;
+}
+
+bool BgHealerFollowSquadAction::isUseful()
+{
+    if (!InLiveOpenWorldBg(bot) || !BattlegroundBotsApi::Enabled() || !PlayerbotAI::IsHeal(bot, true)) return false;
+    ObjectGuid anchor;
+    return BattlegroundBotsApi::GetSquadAnchor(bot, anchor);
+}
+
+bool BgHealerFollowSquadAction::Execute(Event /*event*/)
+{
+    ObjectGuid guid;
+    if (!BattlegroundBotsApi::GetSquadAnchor(bot, guid)) return false;
+    Unit* anchor = botAI->GetUnit(guid);
+    if (!anchor || !anchor->IsAlive() || bot->GetDistance(anchor) <= 20.0f) return false;
+    return MoveNear(anchor, 8.0f);
+}
diff --git a/modules/mod-playerbots/src/Ai/Base/Actions/BgPriorityActions.h b/modules/mod-playerbots/src/Ai/Base/Actions/BgPriorityActions.h
new file mode 100644
index 0000000..1b63964
--- /dev/null
+++ b/modules/mod-playerbots/src/Ai/Base/Actions/BgPriorityActions.h
@@ -0,0 +1,57 @@
+// Ai/Base/Actions/BgPriorityActions.h   (overlay patch 0019)
+#ifndef _PLAYERBOT_BGPRIORITYACTIONS_H
+#define _PLAYERBOT_BGPRIORITYACTIONS_H
+#include "AiObjectContext.h"
+#include "AttackAction.h"
+#include "BgKillTargetValue.h"
+#include "MovementActions.h"
+#include "Player.h"
+
+class PlayerbotAI;
+
+// overlay patch 0019: true while the bot's current victim IS a standing director pick, so stock
+// target choosers must leave the target slot alone. Both values are nullptr when the module is
+// off / not in a live BG, so stock behaviour is byte-identical when disabled.
+// Spelled out rather than via AI_VALUE: that macro lives in Playerbots.h, which this header does
+// not (and should not) pull in — the expansion is exactly this.
+inline bool BgDirectorOwnsVictim(Player* bot, AiObjectContext* context)
+{
+    Unit* v = bot->GetVictim();
+    if (!v) return false;
+    return v == context->GetValue<Unit*>("bg kill target")->Get()
+        || v == context->GetValue<Unit*>("bg peel target")->Get();
+}
+
+// Switch to the director-ranked kill target, with a per-bot retarget cooldown so the bot commits.
+class AttackBgPriorityTargetAction : public AttackAction
+{
+public:
+    AttackBgPriorityTargetAction(PlayerbotAI* botAI) : AttackAction(botAI, "attack bg priority target") {}
+    std::string const GetTargetName() override { return "bg kill target"; }
+    bool isUseful() override;
+    bool Execute(Event event) override;
+private:
+    uint32 _lastSwitchMs = 0;
+};
+
+// Melee only: snare/stun the enemy melee on our FC/healer, then turn on it.
+class BgPeelForAllyAction : public AttackAction
+{
+public:
+    BgPeelForAllyAction(PlayerbotAI* botAI) : AttackAction(botAI, "bg peel for ally") {}
+    std::string const GetTargetName() override { return "bg peel target"; }
+    bool isUseful() override;
+    bool Execute(Event event) override;
+private:
+    uint32 _lastPeelMs = 0;
+};
+
+// Healers with a squad stay within 20y of the squad's living melee anchor instead of the flag.
+class BgHealerFollowSquadAction : public MovementAction
+{
+public:
+    BgHealerFollowSquadAction(PlayerbotAI* botAI) : MovementAction(botAI, "bg healer follow squad") {}
+    bool isUseful() override;
+    bool Execute(Event event) override;
+};
+#endif
