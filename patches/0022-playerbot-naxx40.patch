index 0000000..9a2290d
--- /dev/null
+++ b/modules/mod-playerbots/src/Ai/Raid/Naxx/Naxx40LoathebRules.h
@@ -0,0 +1,376 @@
+/*
+ * This file is part of the mod-playerbots module for AzerothCore. See AUTHORS file for Copyright
+ * information; released under GNU GPL v2 license, redistribute/modify under version 2 of the License,
+ * or (at your option) any later version.
+ */
+
+// Pure rules for the Naxx40 Loatheb (Individual Progression's level-60 Naxxramas). Deliberately
+// free of core and playerbots includes so tests/test_naxx40_loatheb_rules.cpp (overlay repo) builds
+// it standalone:
+//   g++ -std=c++17 -Wall -Wextra -Werror -o /tmp/nx40lb tests/test_naxx40_loatheb_rules.cpp && /tmp/nx40lb
+// Spec: docs/superpowers/specs/2026-10-30-playerbot-naxx40-loatheb-design.md (overlay repo).
+
+#ifndef PLAYERBOTS_NAXX40LOATHEBRULES_H
+#define PLAYERBOTS_NAXX40LOATHEBRULES_H
+
+#include <algorithm>
+#include <cmath>
+#include <cstddef>
+#include <cstdint>
+#include <initializer_list>
+#include <vector>
+
+namespace Naxx40LoathebRules
+{
+    constexpr uint32_t LOATHEB_ENTRY = 351020;
+    constexpr uint32_t SPORE_ENTRY = 351066;
+    constexpr uint32_t BOSS_STATE_ID = 5;
+    constexpr uint32_t DOOM_SPELL = 29204;
+
+    // Corrupted Mind primer / lockout spells, indexed by healer class family (priest-druid / paladin / shaman).
+    constexpr uint32_t CM_PRIMER[3] = {29194, 29196, 29198};
+    constexpr uint32_t CM_LOCKOUT[3] = {29195, 29197, 29199};
+    constexpr uint32_t HEAL_LOCKOUT_MS = 20000;
+
+    constexpr uint32_t POTION_ITEM = 13459;  // Greater Shadow Protection Potion
+    constexpr uint32_t SHADOW_ABSORB_SPELL = 17548;
+    constexpr uint32_t HEALTHSTONE_ITEMS[3] = {9421, 19012, 19013};
+    constexpr uint32_t BANDAGE_ITEM = 14530;
+    constexpr uint32_t RECENTLY_BANDAGED_SPELL = 11196;
+
+    constexpr float POISON_SHOCK_RADIUS = 5.0f;
+    constexpr float BANDAGE_CLEAR = 8.0f;
+    constexpr float FUNGAL_RADIUS = 10.0f;
+    // Spec §4.9 item 3 fallback: a spore alive SPORE_STRAY_MS that never reached the ranged stack is attacked by a DPS
+    // bot within this of it (2-D, centre to centre).
+    constexpr float SPORE_ENGAGE = 8.0f;
+    // Spec §4.9 item 3: a spore is attacked once it is within this of RANGE_SPOT (2-D), so every ranged bot held there
+    // is inside its FUNGAL_RADIUS when it dies.
+    constexpr float SPORE_STACK_RADIUS = 4.0f;
+    constexpr uint32_t SPORE_STRAY_MS = 20000;
+    constexpr float SPORE_TANK_EXCLUDE = 12.0f;
+    constexpr float SPORE_CHOOSER_VETO = 1.5f;  // upstream's spore chooser picks a spore within 1 y (2D surface)
+
+    // Spec §4.8 item 2: the tank rotation is exactly this many bot healers (one heal every ~3.3 s).
+    constexpr size_t ROTATION_SIZE = 6;
+    constexpr uint32_t ROTATION_MIN_SPACING_MS = 2000;
+    constexpr float HEALER_DPS_MANA_PCT = 30.0f;
+    constexpr float MANA_REFILL_BELOW_PCT = 25.0f;
+    constexpr uint32_t STOP_BEFORE_MS = 2000;
+    constexpr uint32_t AFTER_DOOM_WINDOW_MS = 8000;
+    constexpr float HEALTHSTONE_BELOW_PCT = 40.0f;
+    constexpr float BANDAGE_BELOW_PCT = 80.0f;
+    // Spec §4.9 item 2 (was 30): below this any free healer may heal the main tank, and the rotation slot that is up
+    // casts without waiting out the spacing.
+    constexpr float EMERGENCY_TANK_PCT = 50.0f;
+    // Spec §4.9 item 1: below this the first raid heal of an after-Doom window goes to the main tank.
+    constexpr float MT_TOPUP_BELOW_PCT = 60.0f;
+    constexpr float TANK_FULL_PCT = 95.0f;
+    constexpr uint32_t JUST_HEALED_MS = 3000;
+    constexpr float SHIELD_WALL_PCT = 40.0f;
+    constexpr float LAST_STAND_PCT = 30.0f;
+    constexpr float HEAL_REACH = 36.0f;
+    // Prayer of Healing's party radius around the caster: every player rank (596, 996, 10960, 10961, 25316, 25308,
+    // 48072) has EffectRadiusIndex 10 = 30 y in the server's 3.3.5 Spell.dbc / SpellRadius.dbc.
+    constexpr float PRAYER_RADIUS = 30.0f;
+    // Upstream's Loatheb ranged spot (LoathebBossHelper::rangePos, NaxxBossHelper.h), inside the room: bandage
+    // step-outs head toward it (spec §4.7 item 2), and spores are killed once they reach it (spec §4.9 item 3).
+    constexpr float RANGE_SPOT_X = 2896.96f;
+    constexpr float RANGE_SPOT_Y = -3980.61f;
+    // Spec §3: Inevitable Doom comes every 15 s instead of 30 s once this many have resolved.
+    constexpr uint8_t DOOM_FAST_FROM = 6;
+    constexpr uint32_t DIAG_INTERVAL_MS = 5000;
+    constexpr uint32_t REFRESH_INTERVAL_MS = 500;
+
+    // ---- Healer assignment (spec §4.2) ----
+
+    enum class HealerClass : uint8_t
+    {
+        Paladin,
+        Druid,
+        Priest,
+        Shaman
+    };
+
+    struct HealerMember
+    {
+        uint64_t guid;
+        HealerClass cls;
+        uint8_t subgroup;
+        bool human;
+    };
+
+    struct HealerPlan
+    {
+        std::vector<uint64_t> rotation;
+        // The raid healers (spec §4.7 item 3; the field keeps its pre-pull-1 "group healer" name): every bot healer
+        // outside the rotation. They heal the raid right after each Doom (ChooseRaidHeal).
+        std::vector<uint64_t> group;
+    };
+
+    // Spec §4.7 item 3 / §4.8 item 2. Humans are never assigned. The rotation is exactly the first ROTATION_SIZE bot
+    // healers ordered paladins, druids, priests, shamans (member order within a class), or every bot healer if fewer;
+    // every other bot healer is a raid healer. subgroup is not used.
+    inline HealerPlan AssignHealers(std::vector<HealerMember> members)
+    {
+        HealerPlan plan;
+        for (HealerClass cls : {HealerClass::Paladin, HealerClass::Druid, HealerClass::Priest, HealerClass::Shaman})
+        {
+            for (HealerMember const& m : members)
+            {
+                if (m.human || m.cls != cls)
+                    continue;
+                if (plan.rotation.size() < ROTATION_SIZE)
+                    plan.rotation.push_back(m.guid);
+                else
+                    plan.group.push_back(m.guid);
+            }
+        }
+        return plan;
+    }
+
+    // ---- Rotation (spec §4.2) ----
+
+    inline uint32_t RotationSpacingMs(size_t rotationSize)
+    {
+        if (rotationSize == 0)
+            return HEAL_LOCKOUT_MS;
+        return std::max<uint32_t>(HEAL_LOCKOUT_MS / static_cast<uint32_t>(rotationSize), ROTATION_MIN_SPACING_MS);
+    }
+
+    // Below EMERGENCY_TANK_PCT the slot that is up skips the spacing, but never casts within ROTATION_MIN_SPACING_MS of
+    // the last tank heal: without that floor every rotation healer would start its heal within about a second and the
+    // whole rotation would then sit locked out for ~20 s.
+    inline bool RotationCastNow(uint32_t sinceLastTankHealMs, uint32_t spacingMs, float tankPct)
+    {
+        if (tankPct < EMERGENCY_TANK_PCT && sinceLastTankHealMs >= ROTATION_MIN_SPACING_MS)
+            return true;
+        if (sinceLastTankHealMs >= spacingMs && tankPct < TANK_FULL_PCT)
+            return true;
+        return sinceLastTankHealMs >= 2 * spacingMs;
+    }
+
+    // The slot that may cast; SIZE_MAX = nobody. Within the spacing the next slot is up whatever its readiness (the
+    // caller casts only if that bot is ready and RotationCastNow holds); once the spacing has passed it is the first
+    // READY slot after lastCaster, cyclic, lastCaster itself last, so a dead/locked healer costs at most one spacing.
+    inline size_t RotationUp(size_t lastCaster, std::vector<bool> const& ready, uint32_t sinceLastTankHealMs,
+                             uint32_t spacingMs)
+    {
+        size_t const n = ready.size();
+        if (n == 0)
+            return SIZE_MAX;
+        if (sinceLastTankHealMs < spacingMs)
+            return (lastCaster + 1) % n;
+        for (size_t i = 1; i <= n; ++i)
+        {
+            size_t const idx = (lastCaster + i) % n;
+            if (ready[idx])
+                return idx;
+        }
+        return SIZE_MAX;
+    }
+
+    // Milliseconds since a healer's own last heal, from its Corrupted Mind lockout aura's remaining time;
+    // UINT32_MAX when it has no lockout aura (remaining < 0).
+    inline uint32_t MsSinceOwnHeal(int32_t lockoutRemainingMs)
+    {
+        if (lockoutRemainingMs < 0)
+            return UINT32_MAX;
+        uint32_t const remaining = static_cast<uint32_t>(lockoutRemainingMs);
+        if (remaining >= HEAL_LOCKOUT_MS)
+            return 0;
+        return HEAL_LOCKOUT_MS - remaining;
+    }
+
+    // castTimeMs = the damage spell's cast time (0 for the overall test, before a spell is picked): the AI pauses for
+    // the whole cast, so it must end STOP_BEFORE_MS before the heal is due.
+    inline bool HealerMayDps(float manaPct, uint32_t msUntilDue, uint32_t castTimeMs = 0)
+    {
+        return manaPct > HEALER_DPS_MANA_PCT && uint64_t(msUntilDue) > uint64_t(castTimeMs) + STOP_BEFORE_MS;
+    }
+
+    // Spec §3: Inevitable Doom every 30 s, every 15 s once the sixth has resolved (doomCount >= DOOM_FAST_FROM).
+    inline uint32_t DoomIntervalMs(uint8_t doomCount)
+    {
+        return doomCount >= DOOM_FAST_FROM ? 15000 : 30000;
+    }
+
+    // Spec §4.7 item 5: raid healers stop damage spells once Doom is on its 15 s cycle, to keep mana for healing.
+    inline bool RaidHealerMayDps(uint8_t doomCount)
+    {
+        return doomCount < DOOM_FAST_FROM;
+    }
+
+    // ms until the next Doom resolves: the ticking Doom's remaining time; between Dooms lastResolve + DoomIntervalMs
+    // (0 once overdue); UINT32_MAX before the first resolve with none ticking.
+    inline uint32_t MsToNextDoomResolve(uint32_t msToTickingResolve, uint32_t msSinceDoomResolved, uint8_t doomCount)
+    {
+        if (msToTickingResolve != UINT32_MAX)
+            return msToTickingResolve;
+        if (msSinceDoomResolved == UINT32_MAX)
+            return UINT32_MAX;
+        uint32_t const interval = DoomIntervalMs(doomCount);
+        return msSinceDoomResolved >= interval ? 0 : interval - msSinceDoomResolved;
+    }
+
+    // ---- Raid healers (spec §4.7 item 4) ----
+
+    enum class RaidHeal : uint8_t
+    {
+        None,
+        Prayer,  // Prayer of Healing on the priest's own party
+        Chain,   // Chain Heal on the most injured raid member in reach
+        Big      // the class big heal on the most injured raid member in reach
+    };
+
+    // Spec §4.9 item 1: the first raid heal of an after-Doom window tops up the main tank (Loatheb's victim, any
+    // player) when he is below MT_TOPUP_BELOW_PCT, in reach and sight of the raid healer, and no raid healer has
+    // claimed the top-up for this Doom yet. Otherwise he stays out of the raid heals (the rotation covers him).
+    inline bool MainTankTopUp(uint32_t msSinceDoomResolved, float tankPct, bool tankInReach, bool topUpClaimed)
+    {
+        return msSinceDoomResolved <= AFTER_DOOM_WINDOW_MS && tankPct < MT_TOPUP_BELOW_PCT && tankInReach &&
+               !topUpClaimed;
+    }
+
+    // Right after a Doom (AFTER_DOOM_WINDOW_MS) only. topUp (MainTankTopUp held): the heal goes on the main tank, a
+    // shaman's Chain Heal, anyone else's big heal, ahead of Prayer. Otherwise a priest prays when its own party has
+    // >= 2 injured in reach and no other priest has claimed that party for this Doom; otherwise (and for paladins and
+    // druids) the big heal goes on the most injured raid member in reach (hasRaidTarget). A shaman always chain heals
+    // that member.
+    inline RaidHeal ChooseRaidHeal(HealerClass cls, uint32_t msSinceDoomResolved, uint8_t injuredInParty,
+                                   bool partyClaimed, bool hasRaidTarget, bool topUp = false)
+    {
+        if (msSinceDoomResolved > AFTER_DOOM_WINDOW_MS)
+            return RaidHeal::None;
+        if (topUp)
+            return cls == HealerClass::Shaman ? RaidHeal::Chain : RaidHeal::Big;
+        if (cls == HealerClass::Priest && injuredInParty >= 2 && !partyClaimed)
+            return RaidHeal::Prayer;
+        if (!hasRaidTarget)
+            return RaidHeal::None;
+        return cls == HealerClass::Shaman ? RaidHeal::Chain : RaidHeal::Big;
+    }
+
+    // ---- Consumables (spec §4.6) ----
+
+    enum class Consumable : uint8_t
+    {
+        None,
+        Potion,
+        Healthstone,
+        Bandage,
+        StepOut
+    };
+
+    struct ConsumableInput
+    {
+        bool hasDoom;
+        bool potionReady;
+        bool hasShadowAbsorb;
+        uint32_t msSinceDoomResolved;
+        float healthPct;
+        bool healthstoneClaimed;
+        bool healthstoneReady;
+        bool recentlyBandaged;
+        bool bandageReady;
+        bool isBossVictim;
+        bool isTank;  // spec §4.7 item 1: tanks never bandage (nor step out); potions and healthstones still apply
+        // Spec §4.8 item 1: a rotation healer never leaves its spot, so it never bandages (nor steps out) either;
+        // potions and healthstones still apply.
+        bool isRotationHealer;
+        bool isHealer;
+        uint32_t msSinceOwnHeal;
+        float distToBoss;
+    };
+
+    inline Consumable ChooseConsumable(ConsumableInput const& in)
+    {
+        // The consumable would proc a heal's worth of lockout: a healer past its just-healed window keeps its heal.
+        if (in.isHealer && in.msSinceOwnHeal > JUST_HEALED_MS)
+            return Consumable::None;
+        if (in.hasDoom && in.potionReady && !in.hasShadowAbsorb)
+            return Consumable::Potion;
+        bool const afterDoom = in.msSinceDoomResolved <= AFTER_DOOM_WINDOW_MS;
+        if (afterDoom && in.healthPct < HEALTHSTONE_BELOW_PCT && !in.healthstoneClaimed && in.healthstoneReady)
+            return Consumable::Healthstone;
+        if (afterDoom && in.healthPct < BANDAGE_BELOW_PCT && in.bandageReady && !in.recentlyBandaged &&
+            !in.isBossVictim && !in.isTank && !in.isRotationHealer)
+            return in.distToBoss < BANDAGE_CLEAR ? Consumable::StepOut : Consumable::Bandage;
+        return Consumable::None;
+    }
+
+    struct Point2
+    {
+        float x;
+        float y;
+    };
+
+    // Spec §4.7 item 2: where a bandager steps out of Poison Shock. reach (BANDAGE_CLEAR + 1 y plus both units' sizes,
+    // as the caller measures) from Loatheb along the line from him to the ranged spot, or the spot itself when he is
+    // closer to it than that. A fixed spot, so an off-tank never walks past the tank toward the wall.
+    inline Point2 StepOutPoint(float bossX, float bossY, float reach)
+    {
+        float const dx = RANGE_SPOT_X - bossX;
+        float const dy = RANGE_SPOT_Y - bossY;
+        float const d = std::sqrt(dx * dx + dy * dy);
+        if (d <= reach)
+            return Point2{RANGE_SPOT_X, RANGE_SPOT_Y};
+        return Point2{bossX + dx / d * reach, bossY + dy / d * reach};
+    }
+
+    // ---- Spores (spec §4.9 item 3, superseding §4.8 item 3's engage rule) ----
+
+    // Spec §4.7 item 6: measured to Loatheb's current victim only (any unit), not to every living tank. A spore this
+    // close to his victim is never attacked, so the tank never takes Fungal Creep's threat wipe.
+    inline bool SporeNearVictim(float sporeToBossVictim)
+    {
+        return sporeToBossVictim < SPORE_TANK_EXCLUDE;
+    }
+
+    // Spec §4.9 item 3: spores walk to their target, so nobody runs to one; they die at the ranged stack. A DPS bot
+    // (the caller excludes tanks and healers) newly attacks a live spore once the spore is within SPORE_STACK_RADIUS
+    // of RANGE_SPOT (sporeToStack), or, as the fallback for a spore that never gets there, once it has been alive
+    // SPORE_STRAY_MS (sporeAgeMs) and is within SPORE_ENGAGE of the bot. Never one within SPORE_TANK_EXCLUDE of
+    // Loatheb's victim. engaged = the bot is already on this spore: it also keeps it while the spore is within
+    // FUNGAL_RADIUS of the bot (hysteresis, so a spore drifting out of the stack zone does not flip the bot's target;
+    // keeping is a superset of engaging, so a bot walking in to a stacked spore never drops it on the way).
+    inline bool SporeEngages(float sporeToBot, float sporeToStack, uint32_t sporeAgeMs, float sporeToBossVictim,
+                             bool engaged)
+    {
+        if (SporeNearVictim(sporeToBossVictim))
+            return false;
+        if (engaged && sporeToBot <= FUNGAL_RADIUS)
+            return true;
+        if (sporeToStack <= SPORE_STACK_RADIUS)
+            return true;
+        return sporeAgeMs >= SPORE_STRAY_MS && sporeToBot <= SPORE_ENGAGE;
+    }
+
+    // 2-D distance from (x, y) to RANGE_SPOT, for SporeEngages' sporeToStack.
+    inline float DistToRangeSpot(float x, float y)
+    {
+        float const dx = x - RANGE_SPOT_X;
+        float const dy = y - RANGE_SPOT_Y;
+        return std::sqrt(dx * dx + dy * dy);
+    }
+
+    // ---- Tank cooldowns ----
+
+    enum class TankCd : uint8_t
+    {
+        None,
+        ShieldWall,
+        LastStand
+    };
+
+    inline TankCd ChooseTankCd(float hpPct, bool shieldWallReady, bool lastStandReady)
+    {
+        if (hpPct < LAST_STAND_PCT && lastStandReady)
+            return TankCd::LastStand;
+        if (hpPct < SHIELD_WALL_PCT && shieldWallReady)
+            return TankCd::ShieldWall;
+        return TankCd::None;
+    }
+}
+
+#endif
diff --git a/modules/mod-playerbots/src/Ai/Raid/Naxx/Naxx40Patchwerk.cpp b/modules/mod-playerbots/src/Ai/Raid/Naxx/Naxx40Patchwerk.cpp
new file mode 100644
index 0000000..91917f5
--- /dev/null
+++ b/modules/mod-playerbots/src/Ai/Raid/Naxx/Naxx40Patchwerk.cpp
@@ -0,0 +1,687 @@
+/*
+ * This file is part of the mod-playerbots module for AzerothCore. See AUTHORS file for Copyright
+ * information; released under GNU GPL v2 license, redistribute/modify under version 2 of the License,
+ * or (at your option) any later version.
+ */
+
+// Naxx40 Patchwerk helper layer (overlay patch 0022). Spec (overlay repo):
+// docs/superpowers/specs/2026-11-01-playerbot-naxx40-patchwerk-design.md §3, §5. Every pure decision (strike pair,
+// tank priority, roles, caps, healer split, soaker pick, damage samples) is Naxx40PatchwerkRules.h.
+
+#include "Naxx40Patchwerk.h"
+
+#include <algorithm>
+#include <atomic>
+#include <memory>
+#include <mutex>
+#include <string>
+#include <unordered_map>
+#include <unordered_set>
+#include <utility>
+#include <vector>
+
+#include "Creature.h"
+#include "Group.h"
+#include "InstanceScript.h"
+#include "Log.h"
+#include "Map.h"
+#include "ObjectAccessor.h"
+#include "ObjectGuid.h"
+#include "Player.h"
+#include "PlayerbotAI.h"
+#include "Playerbots.h"
+#include "Spell.h"
+#include "StringFormat.h"
+#include "ThreatManager.h"
+#include "Timer.h"
+
+namespace Naxx40Patchwerk
+{
+    using namespace Naxx40PatchwerkRules;
+
+    namespace
+    {
+        // An entry not refreshed for this long is a new attempt (whoever calls GetView after a wipe, or a reused
+        // instance id): it is reset and re-latched from scratch.
+        constexpr uint32 STALE_STATE_MS = 10000;
+
+        // What a view is filled from. The fresh (no refresh due) path copies only this.
+        struct ViewFields
+        {
+            ObjectGuid bossGuid;   // empty = not resolved (or the cached "no living Patchwerk")
+            uint32 gateOpenMs = 0;  // first refresh of the attempt that found him alive; 0 = not yet
+            bool latched = false;
+            Roles roles;
+            StrikePair pair;
+            std::vector<TankInfo> tanks;  // per latched tank, priority order
+            std::shared_ptr<HealerSplit const> healers;
+        };
+
+        // Per-instance encounter state. Bot AI of different instances runs on parallel map threads, so the container
+        // is only touched under g_mutex, held briefly; callers get copies (the HealerSplit as a shared immutable
+        // pointer), never references into it. One instance's bots share one map thread, so a refresh of an instance
+        // (copy out, compute outside the lock, write back) never interleaves with another refresh of it.
+        struct Roster
+        {
+            ViewFields v;
+            std::vector<uint64_t> priority;      // the latched tank priority (TankPriority)
+            std::vector<uint64_t> stockHealers;  // bot healers at the latch outside the split (diag mana only)
+            bool petInPair = false;              // a non-player unit in the strike pair at the last refresh
+            float maxPetThreat = 0.0f;           // highest non-player threat on his list at the last refresh
+            std::unordered_map<uint64_t, uint32> prevHp;        // per latched tank, the last refresh's health
+            std::unordered_map<uint64_t, DamageSample> window;  // per latched tank, since windowStartMs
+            uint32 windowStartMs = 0;
+            uint32 refreshMs = 0;  // 0 = never refreshed
+            uint32 diagMs = 0;     // last "[Naxx40Patchwerk] diag" line; 0 = never
+        };
+
+        // Bot-written parts live beside the roster, so a refresh (which writes back only the roster) never overwrites
+        // them.
+        struct State
+        {
+            Roster roster;
+            std::unordered_map<uint64_t, uint64_t> healClaims;  // NoteHealCast: healer -> target, while casting at it
+            std::unordered_set<uint64_t> manaRefilled;          // ClaimManaRefill
+            uint32 boosts = 0;                                  // NoteThreatBoost, this attempt
+            uint32 cancels = 0;                                 // CancelPrecastHeal, this attempt
+        };
+
+        std::mutex g_mutex;
+        std::unordered_map<uint32, State> g_stateByInstance;
+        // g_stateByInstance.size(), written under g_mutex: keeps the gate-failed erase lock-free while no instance
+        // holds state (every bot in every Naxx instance runs that path when the encounter is not in progress).
+        std::atomic<uint32> g_stateCount{0};
+
+        uint32 NowMs()
+        {
+            uint32 const now = getMSTime();
+            return now ? now : 1;
+        }
+
+        void EraseState(uint32 instanceId)
+        {
+            if (!g_stateCount.load(std::memory_order_relaxed))
+                return;
+            std::lock_guard<std::mutex> lock(g_mutex);
+            g_stateByInstance.erase(instanceId);
+            g_stateCount.store(uint32(g_stateByInstance.size()), std::memory_order_relaxed);
+        }
+
+        // Gate failed after a scan (no living Patchwerk). Drops the attempt like EraseState, but keeps the scan
+        // timestamp so the map-wide scan runs at most once per REFRESH_INTERVAL_MS.
+        void ResetState(uint32 instanceId, uint32 now)
+        {
+            std::lock_guard<std::mutex> lock(g_mutex);
+            State& st = g_stateByInstance[instanceId];
+            st = State{};
+            st.roster.refreshMs = now;
+            g_stateCount.store(uint32(g_stateByInstance.size()), std::memory_order_relaxed);
+        }
+
+        Player* FindPlayer(Map const* map, uint64_t raw)
+        {
+            if (!raw || !ObjectGuid(raw).IsPlayer())
+                return nullptr;
+            Player* p = ObjectAccessor::GetPlayer(map, ObjectGuid(raw));
+            return p && p->IsInWorld() && p->GetMap() == map ? p : nullptr;
+        }
+
+        bool IsHumanOrSelf(Player* p) { return !GET_PLAYERBOT_AI(p) || IsSelfBot(p); }
+
+        // Patchwerk by entry: the cached GUID through Map::GetCreature, else ONE map-wide pass over the spawn store (no
+        // grid-search radius clamp). The caller limits this to once per REFRESH_INTERVAL_MS per instance.
+        Creature* ResolveBoss(Map* map, ObjectGuid& guid)
+        {
+            Creature* c = guid.IsEmpty() ? nullptr : map->GetCreature(guid);
+            if (c)
+                return c;
+            for (auto const& entry : map->GetCreatureBySpawnIdStore())
+            {
+                Creature* cand = entry.second;
+                if (cand && cand->IsInWorld() && cand->GetEntry() == PATCHWERK_ENTRY)
+                {
+                    guid = cand->GetGUID();
+                    return cand;
+                }
+            }
+            return nullptr;
+        }
+
+        // CapRoleOf's rule over raw state (the diag runs it without a view).
+        CapRole RoleFor(Player* p, bool latched, Roles const& roles, std::vector<TankInfo> const& tanks)
+        {
+            if (!p || !latched || IsHumanOrSelf(p))
+                return CapRole::None;
+            uint64_t const me = p->GetGUID().GetRawValue();
+            if (me == roles.mt)
+                return CapRole::None;
+            if (me == roles.soaker[0] || me == roles.soaker[1])
+                return CapRole::Soaker;
+            if (std::find(roles.spares.begin(), roles.spares.end(), me) != roles.spares.end())
+                return CapRole::Spare;
+            // A latched tank without a role is dead (DeriveRoles places every living one).
+            if (std::any_of(tanks.begin(), tanks.end(), [me](TankInfo const& t) { return t.guid == me; }))
+                return CapRole::None;
+            if (PlayerbotAI::IsHeal(p))
+                return CapRole::None;
+            return PlayerbotAI::IsRanged(p) ? CapRole::RangedDps : CapRole::MeleeDps;
+        }
+
+        std::string NameOf(Creature* boss, uint64_t raw)
+        {
+            if (!raw)
+                return "-";
+            Unit* u = ObjectAccessor::GetUnit(*boss, ObjectGuid(raw));
+            return u ? u->GetName() : std::string("?");
+        }
+
+        // "Name 85% 12345" (health %, his threat on it), "Name dead", or "-".
+        std::string TankStr(Map const* map, Creature* boss, uint64_t raw)
+        {
+            if (!raw)
+                return "-";
+            Player* p = FindPlayer(map, raw);
+            if (!p)
+                return "?";
+            if (!p->IsAlive())
+                return Acore::StringFormat("{} dead", p->GetName());
+            return Acore::StringFormat("{} {}% {}", p->GetName(), uint32(p->GetHealthPct()),
+                                       uint32(boss->GetThreatMgr().GetThreat(p)));
+        }
+
+        std::string AvgManaPct(Map const* map, std::vector<uint64_t> const& guids)
+        {
+            uint32 sum = 0;
+            uint32 n = 0;
+            for (uint64_t raw : guids)
+            {
+                Player* p = FindPlayer(map, raw);
+                uint32 const maxMana = p ? p->GetMaxPower(POWER_MANA) : 0;
+                if (!p || !p->IsAlive() || !maxMana)
+                    continue;
+                sum += 100 * p->GetPower(POWER_MANA) / maxMana;
+                ++n;
+            }
+            return n ? Acore::StringFormat("{}%", sum / n) : std::string("-");
+        }
+
+        std::string RolesStr(Map const* map, Creature* boss, Roles const& roles)
+        {
+            std::string spares;
+            for (uint64_t g : roles.spares)
+                spares += (spares.empty() ? "" : ",") + TankStr(map, boss, g);
+            return Acore::StringFormat("mt={} s1={} s2={} spare={}", TankStr(map, boss, roles.mt),
+                                       TankStr(map, boss, roles.soaker[0]), TankStr(map, boss, roles.soaker[1]),
+                                       spares.empty() ? std::string("-") : spares);
+        }
+
+        bool SameRoles(Roles const& a, Roles const& b)
+        {
+            return a.mt == b.mt && a.soaker[0] == b.soaker[0] && a.soaker[1] == b.soaker[1] && a.spares == b.spares;
+        }
+
+        void LogDiag(Map const* map, Creature* boss, Group* group, Roster const& r, uint32 boosts, uint32 cancels,
+                     uint32 now)
+        {
+            uint32 const elapsedS = r.v.gateOpenMs ? getMSTimeDiff(r.v.gateOpenMs, now) / 1000 : 0;
+            uint32 const windowMs = std::max<uint32>(1, getMSTimeDiff(r.windowStartMs, now));
+
+            std::string dmg;
+            for (uint64_t g : r.priority)
+            {
+                auto it = r.window.find(g);
+                DamageSample const s = it != r.window.end() ? it->second : DamageSample{};
+                Player* p = FindPlayer(map, g);
+                dmg += Acore::StringFormat(" {}:dmg={}/s hits={}", p ? p->GetName() : std::string("?"),
+                                           uint64_t(s.dmg) * 1000 / windowMs, s.hits);
+            }
+
+            // The non-tank closest to (or furthest over) its cap: own threat / (limit x reference).
+            std::string topCap = "-";
+            float topPct = -1.0f;
+            uint32 atCap = 0;  // capped non-tanks currently vetoed (ThreatVetoed: own + headroom >= limit x reference)
+            if (group)
+            {
+                for (GroupReference* ref = group->GetFirstMember(); ref; ref = ref->next())
+                {
+                    Player* p = ref->GetSource();
+                    if (!p || !p->IsInWorld() || p->GetMap() != map || !p->IsAlive())
+                        continue;
+                    CapRole const role = RoleFor(p, r.v.latched, r.v.roles, r.v.tanks);
+                    if (role != CapRole::MeleeDps && role != CapRole::RangedDps)
+                        continue;
+                    Cap const cap = CapFor(role, p->GetGUID().GetRawValue(), r.v.roles, r.v.tanks);
+                    if (!cap.capped)
+                        continue;
+                    float const own = boss->GetThreatMgr().GetThreat(p);
+                    if (ThreatVetoed(own, cap))
+                        ++atCap;
+                    float const pct = cap.refThreat > 0.0f ? 100.0f * own / (cap.limit * cap.refThreat)
+                                                           : (own > 0.0f ? 999.0f : 0.0f);
+                    if (pct > topPct)
+                    {
+                        topPct = pct;
+                        topCap = Acore::StringFormat("{} {:.0f}%", p->GetName(), pct);
+                    }
+                }
+            }
+
+            TankInfo const* lower = LowerSoaker(0, r.v.roles, r.v.tanks);
+            std::string const pet = lower && lower->threat > 0.0f
+                                        ? Acore::StringFormat("{:.0f}%", 100.0f * r.maxPetThreat / lower->threat)
+                                        : std::string("-");
+            std::vector<uint64_t> const none;
+            LOG_DEBUG("playerbots",
+                      "[Naxx40Patchwerk] diag boss={}% t={:02}:{:02}/7:00 {}{} pair={}/{} topCap={} atCap={} boosts={} "
+                      "cancels={} pet={}{} mana soak={} mt={} stock={}",
+                      uint32(boss->GetHealthPct()), elapsedS / 60, elapsedS % 60, RolesStr(map, boss, r.v.roles), dmg,
+                      NameOf(boss, r.v.pair.a), NameOf(boss, r.v.pair.b), topCap, atCap, boosts, cancels, pet,
+                      r.petInPair ? " PET-IN-PAIR" : "", AvgManaPct(map, r.v.healers ? r.v.healers->soaker : none),
+                      AvgManaPct(map, r.v.healers ? r.v.healers->mt : none), AvgManaPct(map, r.stockHealers));
+        }
+
+        // One refresh of a grouped bot's instance (outside the lock). Reads his sorted threat list as the boss script
+        // does, latches the tank priority and healer split on the first refresh where a role tank is his victim, then
+        // re-derives roles, samples tank damage and logs the latch / role changes.
+        void Refresh(Map* map, Creature* boss, Group* group, Roster& r, uint32 now)
+        {
+            ThreatManager& threat = boss->GetThreatMgr();
+            std::vector<ThreatEntry> sorted;
+            r.maxPetThreat = 0.0f;
+            for (ThreatReference const* ref : threat.GetSortedThreatList())
+            {
+                Unit* u = ref ? ref->GetVictim() : nullptr;
+                if (!u)
+                    continue;
+                sorted.push_back(
+                    ThreatEntry{u->GetGUID().GetRawValue(), ref->GetThreat(), boss->IsWithinMeleeRange(u)});
+                if (!u->IsPlayer())
+                    r.maxPetThreat = std::max(r.maxPetThreat, ref->GetThreat());
+            }
+            r.v.pair = StrikeCandidates(sorted);
+            r.petInPair = (r.v.pair.a && !ObjectGuid(r.v.pair.a).IsPlayer()) ||
+                          (r.v.pair.b && !ObjectGuid(r.v.pair.b).IsPlayer());
+
+            Unit* const victim = boss->GetVictim();
+            uint64_t const victimRaw = victim ? victim->GetGUID().GetRawValue() : 0;
+
+            if (!r.v.latched)
+            {
+                std::vector<TankInfo> candidates;
+                std::vector<uint64_t> botHealers;
+                bool victimIsTank = false;
+                for (GroupReference* ref = group->GetFirstMember(); ref; ref = ref->next())
+                {
+                    Player* p = ref->GetSource();
+                    if (!p || !p->IsInWorld() || p->GetMap() != map || !p->IsAlive())
+                        continue;
+                    uint64_t const raw = p->GetGUID().GetRawValue();
+                    if (PlayerbotAI::IsTank(p))
+                    {
+                        candidates.push_back(
+                            TankInfo{raw, true, threat.GetThreat(p), p->GetMaxHealth(), boss->IsWithinMeleeRange(p)});
+                        victimIsTank = victimIsTank || raw == victimRaw;
+                    }
+                    else if (PlayerbotAI::IsHeal(p) && !IsHumanOrSelf(p))
+                        botHealers.push_back(raw);
+                }
+                if (!victimIsTank)
+                    return;
+
+                r.priority = TankPriority(candidates);
+                auto split = std::make_shared<HealerSplit const>(SplitHealers(botHealers));
+                r.stockHealers.clear();
+                for (uint64_t g : botHealers)
+                    if (std::find(split->soaker.begin(), split->soaker.end(), g) == split->soaker.end() &&
+                        std::find(split->mt.begin(), split->mt.end(), g) == split->mt.end())
+                        r.stockHealers.push_back(g);
+                r.v.healers = std::move(split);
+                r.v.latched = true;
+                r.windowStartMs = now;
+                if (sLog->ShouldLog("playerbots", LogLevel::LOG_LEVEL_DEBUG))
+                {
+                    std::string names;
+                    for (uint64_t g : r.priority)
+                    {
+                        Player* p = FindPlayer(map, g);
+                        names += Acore::StringFormat("{}{}({})", names.empty() ? "" : ",",
+                                                     p ? p->GetName() : std::string("?"), p ? p->GetMaxHealth() : 0);
+                    }
+                    LOG_DEBUG("playerbots",
+                              "[Naxx40Patchwerk] latch tanks={} healers soak={} mt={} stock={} victim={} after {}ms",
+                              names, r.v.healers->soaker.size(), r.v.healers->mt.size(), r.stockHealers.size(),
+                              NameOf(boss, victimRaw), r.v.gateOpenMs ? getMSTimeDiff(r.v.gateOpenMs, now) : 0);
+                }
+            }
+
+            r.v.tanks.clear();
+            for (uint64_t g : r.priority)
+            {
+                Player* p = FindPlayer(map, g);
+                bool const alive = p && p->IsAlive();
+                r.v.tanks.push_back(TankInfo{g, alive, p ? threat.GetThreat(p) : 0.0f, p ? p->GetMaxHealth() : 0,
+                                             alive && boss->IsWithinMeleeRange(p)});
+                // Damage sample against the previous refresh's health; a dead or absent tank restarts its baseline.
+                if (!alive)
+                {
+                    r.prevHp.erase(g);
+                    continue;
+                }
+                uint32 const cur = p->GetHealth();
+                auto it = r.prevHp.find(g);
+                if (it != r.prevHp.end())
+                    AddSample(r.window[g], it->second, cur);
+                r.prevHp[g] = cur;
+            }
+
+            Roles const roles = DeriveRoles(r.priority, r.v.tanks, victimRaw);
+            bool const changed = !SameRoles(roles, r.v.roles);
+            r.v.roles = roles;
+            if (changed && sLog->ShouldLog("playerbots", LogLevel::LOG_LEVEL_DEBUG))
+                LOG_DEBUG("playerbots", "[Naxx40Patchwerk] roles {}", RolesStr(map, boss, r.v.roles));
+        }
+
+        // A heal claim is held while the healer is still casting at its target.
+        bool ClaimLive(Map const* map, uint64_t healer, uint64_t target)
+        {
+            Player* p = FindPlayer(map, healer);
+            if (!p || !p->IsAlive())
+                return false;
+            Spell* const spell = p->GetCurrentSpell(CURRENT_GENERIC_SPELL);
+            return spell && spell->m_targets.GetUnitTargetGUID().GetRawValue() == target;
+        }
+
+        void FillView(Map* map, ViewFields const& f, uint32 now, PatchwerkView& view)
+        {
+            Creature* c = f.bossGuid.IsEmpty() ? nullptr : map->GetCreature(f.bossGuid);
+            view.boss = c && c->IsAlive() ? c : nullptr;
+            view.latched = f.latched;
+            view.openerHold =
+                !f.latched && (!f.gateOpenMs || getMSTimeDiff(f.gateOpenMs, now) < OPENER_FAIL_OPEN_MS);
+            view.roles = f.roles;
+            view.pair = f.pair;
+            view.tanks = f.tanks;
+            view.healers = f.healers;
+        }
+
+        // The latched state of the bot's instance, under g_mutex (the caller holds it); null when none is latched.
+        State* LatchedState(Player* bot)
+        {
+            auto it = g_stateByInstance.find(bot->GetMap()->GetInstanceId());
+            if (it == g_stateByInstance.end() || !it->second.roster.v.latched)
+                return nullptr;
+            return &it->second;
+        }
+
+        // The view's latched tanks with this tick's threat re-read from the boss (the reference is this tick's, not the
+        // last refresh's). A tank that died since the refresh is never a reference.
+        std::vector<TankInfo> LiveTanks(Map const* map, PatchwerkView const& view)
+        {
+            std::vector<TankInfo> live = view.tanks;
+            for (TankInfo& t : live)
+            {
+                if (!t.alive)
+                    continue;
+                Player* p = FindPlayer(map, t.guid);
+                t.alive = p && p->IsAlive();
+                if (t.alive)
+                    t.threat = view.boss->GetThreatMgr().GetThreat(p);
+            }
+            return live;
+        }
+    }
+
+    bool GetView(Player* bot, PatchwerkView& view)
+    {
+        view = PatchwerkView{};
+
+        if (!bot || !bot->IsInWorld() || bot->GetMapId() != NAXX40_MAP_ID)
+            return false;
+        Map* const map = bot->GetMap();
+        uint32 const instanceId = map->GetInstanceId();
+        // IP's Naxx40 only: WotLK Naxx (10/25 normal) keeps upstream's Patchwerk untouched.
+        if (map->GetDifficulty() != RAID_DIFFICULTY_10MAN_HEROIC)
+        {
+            EraseState(instanceId);
+            return false;
+        }
+        InstanceScript* const instance = bot->GetInstanceScript();
+        if (!instance)
+            return false;
+
+        // Not IN_PROGRESS (before the pull, a wipe, the kill): drop the attempt so the next pull re-latches.
+        if (instance->GetBossState(BOSS_STATE_ID) != IN_PROGRESS)
+        {
+            EraseState(instanceId);
+            return false;
+        }
+
+        uint32 const now = NowMs();
+        Roster r;
+        std::unordered_map<uint64_t, uint64_t> claims;
+        uint32 boosts = 0;
+        uint32 cancels = 0;
+        bool fresh = false;
+        ViewFields snap;
+        {
+            std::lock_guard<std::mutex> lock(g_mutex);
+            auto it = g_stateByInstance.find(instanceId);
+            if (it != g_stateByInstance.end())
+            {
+                Roster const& cur = it->second.roster;
+                uint32 const age = cur.refreshMs ? getMSTimeDiff(cur.refreshMs, now) : 0;
+                if (cur.refreshMs && age >= STALE_STATE_MS)
+                    it->second = State{};  // a new attempt: r stays default, so it latches from scratch
+                else if (cur.refreshMs && age < REFRESH_INTERVAL_MS)
+                {
+                    if (cur.v.bossGuid.IsEmpty())
+                        return false;  // cached "no living Patchwerk"
+                    fresh = true;
+                    snap = cur.v;  // no refresh due: only what the view needs
+                }
+                else
+                {
+                    r = cur;  // a refresh is due: copy what it needs
+                    claims = it->second.healClaims;
+                    boosts = it->second.boosts;
+                    cancels = it->second.cancels;
+                }
+            }
+        }
+        if (fresh)
+        {
+            FillView(map, snap, now, view);
+            if (view.boss)
+                return true;
+            view = PatchwerkView{};
+            // He died: refresh now (which resets the state). Needs the stored roster.
+            std::lock_guard<std::mutex> lock(g_mutex);
+            auto it = g_stateByInstance.find(instanceId);
+            if (it != g_stateByInstance.end())
+                r = it->second.roster;
+        }
+
+        // The scan and every computation run outside the lock (see Roster).
+        Creature* const boss = ResolveBoss(map, r.v.bossGuid);
+        if (!boss || !boss->IsAlive())
+        {
+            ResetState(instanceId, now);
+            return false;
+        }
+
+        r.refreshMs = now;
+        if (!r.v.gateOpenMs)
+            r.v.gateOpenMs = now;
+        // An ungrouped bot would latch a one-member raid: it never latches or refreshes the roles, and reads the last
+        // refreshed state, if any. Its scan is still stored, so it does not rescan on every call.
+        Group* const group = bot->GetGroup();
+        if (group)
+            Refresh(map, boss, group, r, now);
+
+        std::vector<uint64_t> dropped;
+        for (auto const& [healer, target] : claims)
+            if (!ClaimLive(map, healer, target))
+                dropped.push_back(healer);
+
+        if (r.v.latched && (!r.diagMs || getMSTimeDiff(r.diagMs, now) >= DIAG_INTERVAL_MS))
+        {
+            r.diagMs = now;
+            if (sLog->ShouldLog("playerbots", LogLevel::LOG_LEVEL_DEBUG))
+                LogDiag(map, boss, group, r, boosts, cancels, now);
+            r.window.clear();
+            r.windowStartMs = now;
+        }
+
+        {
+            std::lock_guard<std::mutex> lock(g_mutex);
+            State& st = g_stateByInstance[instanceId];
+            st.roster = r;  // keeps the claims and the refills
+            for (uint64_t healer : dropped)
+            {
+                auto it = st.healClaims.find(healer);
+                if (it != st.healClaims.end() && claims.count(healer) && claims[healer] == it->second)
+                    st.healClaims.erase(it);
+            }
+            g_stateCount.store(uint32(g_stateByInstance.size()), std::memory_order_relaxed);
+        }
+
+        FillView(map, r.v, now, view);
+        return view.boss != nullptr;
+    }
+
+    CapRole CapRoleOf(Player* bot, PatchwerkView const& view)
+    {
+        return RoleFor(bot, view.latched, view.roles, view.tanks);
+    }
+
+    Cap CapOf(Player* bot, PatchwerkView const& view)
+    {
+        CapRole const role = CapRoleOf(bot, view);
+        if (role == CapRole::None || !view.boss)
+            return Cap{};
+        return CapFor(role, bot->GetGUID().GetRawValue(), view.roles, LiveTanks(bot->GetMap(), view));
+    }
+
+    float ThreatBoostOf(Player* bot, PatchwerkView const& view)
+    {
+        if (!bot || !view.latched || !view.boss)
+            return 0.0f;
+        return ThreatBoostFor(bot->GetGUID().GetRawValue(), view.roles, LiveTanks(bot->GetMap(), view));
+    }
+
+    void NoteThreatBoost(Player* bot)
+    {
+        if (!bot || !bot->IsInWorld())
+            return;
+        std::lock_guard<std::mutex> lock(g_mutex);
+        if (State* st = LatchedState(bot))
+            ++st->boosts;
+    }
+
+    HealerJob HealerJobOf(Player* bot, PatchwerkView const& view)
+    {
+        if (!bot || !view.latched || !view.healers || IsHumanOrSelf(bot))
+            return HealerJob::None;
+        uint64_t const me = bot->GetGUID().GetRawValue();
+        auto const& s = view.healers->soaker;
+        if (std::find(s.begin(), s.end(), me) != s.end())
+            return HealerJob::Soaker;
+        auto const& m = view.healers->mt;
+        if (std::find(m.begin(), m.end(), me) != m.end())
+            return HealerJob::MainTank;
+        return HealerJob::None;
+    }
+
+    Player* SoakerHealTarget(Player* bot, PatchwerkView const& view)
+    {
+        if (!bot || !bot->IsInWorld() || !view.boss)
+            return nullptr;
+        Map const* map = bot->GetMap();
+        auto resolve = [map](uint64_t raw) -> Player*
+        {
+            // Pull 1: full-health members ARE candidates. A soaker is struck about every 2.4 s, so a heal started only
+            // once it is damaged lands after the next strike; KeepPrecastHeal keeps PlayerbotAI::UpdateAI from
+            // interrupting the pre-cast.
+            Player* p = FindPlayer(map, raw);
+            return p && p->IsAlive() ? p : nullptr;
+        };
+        Player* const a = resolve(view.pair.a);
+        Player* const b = resolve(view.pair.b);
+        if (!a && !b)
+            return nullptr;
+        uint64_t const aRaw = a ? a->GetGUID().GetRawValue() : 0;
+        uint64_t const bRaw = b ? b->GetGUID().GetRawValue() : 0;
+
+        uint32 aClaims = 0;
+        uint32 bClaims = 0;
+        {
+            uint64_t const me = bot->GetGUID().GetRawValue();
+            std::lock_guard<std::mutex> lock(g_mutex);
+            if (State const* st = LatchedState(bot))
+                for (auto const& [healer, target] : st->healClaims)
+                {
+                    if (healer == me)
+                        continue;
+                    aClaims += aRaw && target == aRaw;
+                    bClaims += bRaw && target == bRaw;
+                }
+        }
+        uint64_t const pick = PickSoakerTarget(aRaw, a ? a->GetHealthPct() : 0.0f, aClaims, bRaw,
+                                               b ? b->GetHealthPct() : 0.0f, bClaims);
+        return pick == aRaw ? a : b;
+    }
+
+    bool KeepPrecastHeal(Player* bot, Unit* target)
+    {
+        if (!bot || !target || bot->GetMapId() != NAXX40_MAP_ID || !target->IsPlayer())
+            return false;
+        PatchwerkView view;
+        if (!GetView(bot, view) || !view.latched || HealerJobOf(bot, view) != HealerJob::Soaker)
+            return false;
+        uint64_t const raw = target->GetGUID().GetRawValue();
+        return raw == view.pair.a || raw == view.pair.b;
+    }
+
+    bool CancelPrecastHeal(Player* bot, Spell* spell, Unit* target)
+    {
+        if (!bot || !spell || !target || bot->GetMapId() != NAXX40_MAP_ID)
+            return false;
+        PatchwerkView view;
+        if (!GetView(bot, view) || !view.latched || HealerJobOf(bot, view) != HealerJob::Soaker ||
+            !target->IsAlive())
+            return false;
+        if (!ShouldCancelPrecast(spell->GetCastTimeRemaining(), target->GetHealthPct()))
+            return false;
+        std::lock_guard<std::mutex> lock(g_mutex);
+        if (State* st = LatchedState(bot))
+            ++st->cancels;
+        return true;
+    }
+
+    void NoteHealCast(Player* bot, Player* target)
+    {
+        if (!bot || !target || !bot->IsInWorld())
+            return;
+        std::lock_guard<std::mutex> lock(g_mutex);
+        if (State* st = LatchedState(bot))
+            st->healClaims[bot->GetGUID().GetRawValue()] = target->GetGUID().GetRawValue();
+    }
+
+    bool ClaimManaRefill(Player* bot)
+    {
+        if (!bot || !bot->IsInWorld())
+            return false;
+        std::lock_guard<std::mutex> lock(g_mutex);
+        State* st = LatchedState(bot);
+        return st && st->manaRefilled.insert(bot->GetGUID().GetRawValue()).second;
+    }
+
+    bool ManaRefillClaimed(Player* bot)
+    {
+        if (!bot || !bot->IsInWorld())
+            return true;
+        std::lock_guard<std::mutex> lock(g_mutex);
+        State const* st = LatchedState(bot);
+        return !st || st->manaRefilled.count(bot->GetGUID().GetRawValue());
+    }
+}
diff --git a/modules/mod-playerbots/src/Ai/Raid/Naxx/Naxx40Patchwerk.h b/modules/mod-playerbots/src/Ai/Raid/Naxx/Naxx40Patchwerk.h
