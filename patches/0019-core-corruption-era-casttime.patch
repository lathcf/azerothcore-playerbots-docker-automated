 uint32 SpellInfo::CalcCastTime(Unit* caster, Spell* spell) const
 {
+    // era-talents patch 0019: restore the Vanilla base cast time for a Vanilla-era warlock's Corruption.
+    // Corruption is instant in WotLK, and mod-individual-progression does NOT restore Vanilla cast times,
+    // so the Improved Corruption talent's cast-time SPELLMOD (node 18202) has nothing to reduce. We cannot
+    // edit spell 172 globally (spell_dbc + client Spell.dbc are global; eras are per-character), and the
+    // core cannot read the IP era. So mod-era-talents grants the hidden marker aura 932930 (DUMMY misc 5)
+    // to Vanilla-era warlocks via ReconcileBaselineSpells; here we override the base cast time to 2000ms
+    // BEFORE ModSpellCastTime (so the SPELLMOD still reduces it) and BEFORE the !CastTimeEntry early-return
+    // (Corruption's instant cast index may be null). Gate on the spell Id FIRST (cheap map lookup, false
+    // for ~every cast) so HasAura() only runs for a Corruption rank — CalcCastTime is a hot path.
+    static std::unordered_map<uint32, int32> const s_eraVanillaCastTime =
+    {
+        { 172, 2000 }, { 6222, 2000 }, { 6223, 2000 }, { 7648, 2000 },
+        { 11671, 2000 }, { 11672, 2000 }, { 25311, 2000 },   // Corruption ranks 1-7 (== _ref.corruptionRanks)
+    };
+    int32 eraBase = -1;
+    if (caster)
+    {
+        auto it = s_eraVanillaCastTime.find(Id);
+        if (it != s_eraVanillaCastTime.end() && caster->HasAura(932930 /*ERA_VANILLA_CASTTIME_MARKER, misc 5*/))
+            eraBase = it->second;
+    }
+
     // not all spells have cast time index and this is all is pasiive abilities
-    if (!CastTimeEntry)
+    if (!CastTimeEntry && eraBase < 0)
         return 0;
 
-    int32 castTime = CastTimeEntry->CastTime;
+    int32 castTime = (eraBase >= 0) ? eraBase : CastTimeEntry->CastTime;
     if (HasAttribute(SPELL_ATTR0_USES_RANGED_SLOT) && (!IsAutoRepeatRangedSpell()))
         castTime += 500;
 
