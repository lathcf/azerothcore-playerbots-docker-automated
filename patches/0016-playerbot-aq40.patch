+
+#ifndef PLAYERBOTS_AQ40CTHUNHELPERS_H
+#define PLAYERBOTS_AQ40CTHUNHELPERS_H
+
+#include <cmath>
+#include <string>
+
+#include "Common.h"
+#include "Position.h"
+
+class Creature;
+class Player;
+class PlayerbotAI;
+class Unit;
+
+namespace TempleOfAhnQirajHelpers
+{
+
+// InstanceScript data ids from temple_of_ahnqiraj.h (script-local, so hardcoded; printed at strategy
+// load so a drift shows in the log rather than as a silently dead encounter gate). The Eye and the
+// body are both BossAI(creature, DATA_CTHUN): one boss slot, IN_PROGRESS across both phases.
+constexpr uint32 AQT_DATA_CTHUN = 9;
+constexpr uint32 AQT_DATA_EYE_OF_CTHUN = 18;
+
+constexpr uint32 NPC_CTHUN_CLAW_TENTACLE = 15725;
+constexpr uint32 NPC_CTHUN_EYE_TENTACLE = 15726;
+constexpr uint32 NPC_CTHUN_GIANT_CLAW_TENTACLE = 15728;
+constexpr uint32 NPC_CTHUN_GIANT_EYE_TENTACLE = 15334;
+constexpr uint32 NPC_CTHUN_FLESH_TENTACLE = 15802;
+
+// 2s cast, chains up to 60 targets, each jump within 10y of the previous victim (magic damage
+// class, Spell::SearchChainTargets). Nobody within 10y of the target = it hits only the target.
+constexpr uint32 SPELL_CTHUN_GREEN_BEAM = 26134;
+// On the Eye (permanent duration) for the whole Dark Glare phase, wind-up included.
+constexpr uint32 SPELL_CTHUN_FREEZE_ANIM = 16245;
+// -100% damage taken, all schools. Removed while C'Thun is weakened.
+constexpr uint32 SPELL_CTHUN_CARAPACE = 26156;
+// Stomach DoT, +1 stack every 5s, removed on exit.
+constexpr uint32 SPELL_CTHUN_DIGESTIVE_ACID = 26476;
+// Stomach grab: stun + MOUNTED aura for 3.8s before the teleport. Never cancel it.
+constexpr uint32 SPELL_CTHUN_MOUTH_TENTACLE = 26332;
+
+// Client-side area trigger: bots never send it themselves (no client), so the exit action sends
+// CMSG_AREATRIGGER for them. The handler checks the bot is within 5y of this point.
+constexpr uint32 AT_CTHUN_STOMACH_EXIT = 4033;
+constexpr float CTHUN_STOMACH_EXIT_X = -8546.2f;
+constexpr float CTHUN_STOMACH_EXIT_Y = 1987.7f;
+constexpr float CTHUN_STOMACH_EXIT_Z = -96.5f;
+
+// ---- tuning: round numbers with obvious slack, not derived margins ----
+// Stomach exit: stack N costs 149*N per 5s tick. Unhealed, 7 stacks is ~4.2k cumulative; with a
+// healer in the stomach alongside, bots stay to 12. Low health always leaves.
+constexpr uint32 CTHUN_ACID_EXIT_STACKS = 7;
+constexpr uint32 CTHUN_ACID_EXIT_STACKS_HEALED = 12;
+constexpr float CTHUN_STOMACH_EXIT_HEALTH_PCT = 35.0f;
+constexpr float CTHUN_EXIT_REACHED = 3.0f;       // inside the 5y trigger
+constexpr uint32 CTHUN_EXIT_HOLD_MS = 4000;      // script re-checks our position 3s after the trigger
+constexpr float CTHUN_STOMACH_RADIUS = 100.0f;   // "near the stomach", 2D from the exit point
+// Server-side bots get no client gravity: the swallow teleport lands at z ~-70 over a floor near
+// -97; that landing is the only hover we correct (see GetCthunAirborneState).
+// Stomach landing hover: swallowed players arrive at z -70 over a floor near -97.
+constexpr float CTHUN_STOMACH_HOVER_Z = -90.0f;
+constexpr float CTHUN_STOMACH_FLOOR_MIN_Z = -110.0f;
+constexpr float CTHUN_GROUND_SEARCH = 150.0f;
+// Flesh Tentacles sit directly below the body (~198y 3D), so the count search is wide.
+constexpr float CTHUN_FLESH_SEARCH_RANGE = 250.0f;
+// Stomach close-in: pathfinding-based reach fails in the stomach, so bots are walked into range of
+// a Flesh Tentacle (combat reach 15: melee needs ~<17y, casters ~<45y).
+constexpr float CTHUN_STOMACH_MELEE_RANGE = 10.0f;
+constexpr float CTHUN_STOMACH_RANGED_RANGE = 28.0f;
+
+// Green Beam chain jump: chainSource->IsWithinDist(target, 10) ADDS both object sizes (~1.5 each),
+// so the effective jump is ~13y centre-to-centre.
+constexpr float CTHUN_BEAM_CLEAR_RANGE = 14.0f;
+constexpr float CTHUN_BEAM_HOLD_RANGE = 20.0f;   // don't walk to a slot near a beam in flight
+
+constexpr float CTHUN_GLARE_HALF_WIDTH = 5.0f;     // beam half-width, yards
+constexpr float CTHUN_GLARE_PAD = 3.0f;            // extra yards on the edge
+constexpr float CTHUN_GLARE_SWEEP_RATE = float(M_PI) / 35.0f;  // rad/s: 180 deg over 35s
+constexpr float CTHUN_GLARE_MOVE_SECONDS = 4.0f;   // start dodging this long before it can hit
+constexpr float CTHUN_GLARE_SAFE_SECONDS = 9.0f;   // dodge to this far ahead of the beam
+constexpr uint32 CTHUN_GLARE_CAST_PAD_MS = 1000;   // cast-safety veto slack
+constexpr float CTHUN_GLARE_MAX_RANGE = 100.0f;    // only bots in the room
+constexpr uint32 CTHUN_GLARE_SECTORS = 64;
+
+// FIXED spots, spaced BY CONSTRUCTION past the ~13y effective chain jump (IsWithinDist(10) adds both
+// object sizes); no disperse. Ranged (Eye phase): two full interleaved circles around the Eye (~13
+// per ring -> ~15y between neighbours on A, ~15.6y to the nearest B spot, 15y outside the melee
+// ring); B stays inside the ~46.5y Eye casting range.
+constexpr float CTHUN_RANGED_RING_A = 30.5f;
+constexpr float CTHUN_RANGED_RING_B = 43.5f;
+// Melee (tanks included), Eye phase only: 6 spots on a ring in the Eye's melee reach (~17y from its
+// centre, combat reach 15; chord 15.5y) plus the centre, 2 bots per spot so a Green Beam chain can
+// jump once (to the partner) and stop. The partner stands 1y tangentially off the spot. Overflow
+// bots (rank >= 14) take the half-steps between ring spots.
+constexpr float CTHUN_MELEE_RING = 15.5f;
+constexpr uint32 CTHUN_MELEE_RING_SPOTS = 6;
+constexpr uint32 CTHUN_MELEE_PER_SPOT = 2;
+constexpr float CTHUN_MELEE_PAIR_OFFSET = 1.0f;
+// During the opening melee stage at +-90 deg off the puller's lane (which runs along the ring
+// reference through the centre), 35y out, pairs spread 12y apart along that circle.
+constexpr float CTHUN_MELEE_STAGE_RADIUS = 35.0f;
+constexpr float CTHUN_MELEE_STAGE_SPACING = 12.0f;
+constexpr float CTHUN_SLOT_TOLERANCE = 1.5f;
+// The script fires exactly 3 Green Beams at the engager (RepeatCounter < 3 -> casts at 3/6/9s, 2s
+// cast); the first random beam begins 5s after the 3rd cast started. The opening ends when the 3rd
+// has landed.
+constexpr uint32 CTHUN_OPENING_PULLER_BEAMS = 3;
+constexpr float CTHUN_PULLER_RADIUS = 25.0f;     // puller's far-side hold, from the Eye
+// No-go zone around the opening puller for everyone else, for the whole opening.
+// Chain reach is ~13y centre-to-centre; these keep a few yards of slack without making the raid
+// back away and wait at the pull (25y did).
+constexpr float CTHUN_PULLER_AVOID_RANGE = 16.0f;  // inside -> retreat to ~21y
+constexpr float CTHUN_PULLER_HOLD_RANGE = 20.0f;   // inside -> don't advance
+
+constexpr float CTHUN_MELEE_ADD_RANGE = 8.0f;     // non-tank melee only take a claw that is on them
+// Ranged hold a fixed spot and never close range, so they only pick adds they can hit from it.
+constexpr float CTHUN_RANGED_ADD_RANGE = 36.0f;
+constexpr float CTHUN_RANGED_CLAW_RANGE = 25.0f;  // ranged help with claws this close to them
+constexpr float CTHUN_SEARCH_RANGE = 100.0f;     // grid searches, always issued FROM the bot
+constexpr uint32 CTHUN_SNAPSHOT_TTL_MS = 500;
+
+enum class CthunPhase : uint8
+{
+    None = 0,  // not engaged, or the ~3.5s Eye -> body transition
+    Eye,
+    Body
+};
+
+// Per-instance half-second snapshot. Returned BY VALUE: the cache is mutex-guarded and shared
+// across map-update threads.
+struct CthunSnapshot
+{
+    uint32 takenAtMs = 0;
+    bool valid = false;
+    CthunPhase phase = CthunPhase::None;
+    bool weakened = false;  // Body phase with both Flesh Tentacles dead (the script's own rule)
+    uint32 fleshAlive = 0;  // living Flesh Tentacles (stomach)
+    bool glare = false;     // Dark Glare phase (wind-up included)
+    float beamAngle = 0.0f; // Eye's facing while glare
+    float centerX = 0.0f;   // Eye and body are co-located
+    float centerY = 0.0f;
+    float centerZ = 0.0f;
+};
+
+// ---- encounter state ----
+bool IsCthunEncounterActive(Player* bot);
+CthunSnapshot GetCthunSnapshot(Player* bot);
+bool IsInCthunStomach(Player* bot);
+void CthunEraseTrackers(Player* bot);
+
+// ---- stomach ----
+bool CthunShouldExitStomach(Player* bot);  // owed and not already holding after a sent trigger
+// Why the bot owes a stomach exit ("acid N" / "no flesh (weakened)"), or "" when it does not.
+std::string CthunExitReason(Player* bot);
+enum class CthunAirborne : uint8
+{
+    None = 0,
+    Hovering,   // stomach landing hover (z > CTHUN_STOMACH_HOVER_Z): teleport down
+    StaleFall   // on the ground but MOVEMENTFLAG_FALLING* still set: scrub the flags
+};
+// A bot never sends the landing opcode, so a fall's FALLING flag sticks and isMoving() stays true
+// (every cast-time spell then fails). groundZ is filled for logging.
+CthunAirborne GetCthunAirborneState(Player* bot, PlayerbotAI* botAI, float& groundZ);
+// Where to walk to get into range of the stomach target (healers: the nearest Flesh Tentacle);
+// false when already in range, leaving, or unable to move.
+bool GetCthunStomachApproachSpot(Player* bot, PlayerbotAI* botAI, Position& spot);
+bool IsCthunExitHolding(Player* bot);
+void CthunStartExitHold(Player* bot);
+
+// ---- Dark Glare ----
+// Worst-case seconds until the Dark Glare beam can reach the bot (beam sweeping toward it); 999
+// when there is no glare / not applicable.
+float CthunGlareSecondsToHit(Player* bot);
+bool GetCthunGlareDodgeSpot(Player* bot, Position& spot);
+bool CthunShouldDodgeGlare(Player* bot);
+
+// ---- Green Beam ----
+// True while the bot is the unit target of any Green Beam being cast.
+bool IsCthunBeamTarget(Player* bot);
+// What this bot must step away from: a beam target within CTHUN_BEAM_CLEAR_RANGE, or - if the bot
+// IS a beam target - its nearest living room-side raid member within that range. nullptr = clear.
+Unit* GetCthunBeamThreat(Player* bot);
+bool CthunShouldClearBeam(Player* bot);
+bool GetCthunBeamClearSpot(Player* bot, Position& spot, uint32 attempt = 0);
+
+// ---- opening ----
+// The Eye's first four Green Beams all go to the engager. Until the first beam at someone else (or
+// the puller dies / the Eye phase ends), that bot drags them to the side opposite the raid.
+bool IsCthunOpeningPuller(Player* bot);
+// The opening runs (entry exists and not over). Melee wait it out where they are.
+bool IsCthunOpeningActive(Player* bot);
+bool GetCthunPullerSpot(Player* bot, Position& spot);  // false once arrived (hold)
+// The opening puller (never this bot) while the opening runs, if within range (2D); else nullptr.
+Player* GetCthunOpeningPullerWithin(Player* bot, float range);
+
+// ---- fixed spots ----
+// Ranged role for spots: healer or ranged, never a tank.
+bool IsCthunRangedRole(Player* member);
+// Walk back to the bot's FIXED spot whenever off it (melee: the opening staging point first).
+bool CthunShouldFormUp(Player* bot, PlayerbotAI* botAI);
+bool GetCthunFormUpSpot(Player* bot, PlayerbotAI* botAI, Position& spot);
+
+// ---- targeting ----
+Unit* GetCthunAttackTarget(Player* bot, PlayerbotAI* botAI);
+bool IsCthunHoldingFire(Player* bot, PlayerbotAI* botAI);
+bool CthunShouldRetarget(Player* bot, PlayerbotAI* botAI);
+
+// Shared by the triggers and the movement multiplier so they cannot disagree.
+bool CthunHazardMoveOwed(Player* bot);
+// Mounted (e.g. rode in with the master) and nowhere to go right now: dismount so the bot can fight.
+// The Mouth Tentacle grab is also a MOUNTED aura (26332) and is left alone.
+bool CthunShouldDismount(Player* bot, PlayerbotAI* botAI);
+bool CthunShouldSuppressGenericMovement(Player* bot, PlayerbotAI* botAI);
+
+}  // namespace TempleOfAhnQirajHelpers
+
+#endif
diff --git a/modules/mod-playerbots/src/Ai/Raid/Aq40/Aq40Helpers.cpp b/modules/mod-playerbots/src/Ai/Raid/Aq40/Aq40Helpers.cpp
new file mode 100644
index 0000000..b981544
--- /dev/null
+++ b/modules/mod-playerbots/src/Ai/Raid/Aq40/Aq40Helpers.cpp
@@ -0,0 +1,645 @@
+/*
+ * This file is part of the mod-playerbots module for AzerothCore. See AUTHORS file for Copyright
+ * information; released under GNU GPL v2 license, redistribute/modify under version 2 of the License,
+ * or (at your option) any later version.
+ */
+
+#include "Aq40Helpers.h"
+
+#include <cmath>
+#include <list>
+#include <mutex>
+#include <unordered_map>
+#include <vector>
+
+#include "Creature.h"
+#include "DynamicObject.h"
+#include "Group.h"
+#include "InstanceScript.h"
+#include "Map.h"
+#include "ObjectAccessor.h"
+#include "Pet.h"
+#include "Playerbots.h"
+#include "SharedDefines.h"
+#include "Timer.h"
+
+namespace TempleOfAhnQirajHelpers
+{
+
+namespace
+{
+    // Different instances update on parallel map threads: two AQ40 raids would race on an unlocked
+    // container and rehash under each other (the Aug 25-26 prod crashes). One lock, held briefly.
+    std::mutex twinsMutex;
+    std::unordered_map<uint32, TwinsSnapshot> twinsSnapshotByInstance;
+}
+
+bool IsInAq40(Player* bot)
+{
+    return bot && bot->GetMapId() == AQ40_MAP_ID;
+}
+
+Creature* GetTwin(Player* bot, uint32 dataId)
+{
+    if (!IsInAq40(bot))
+        return nullptr;
+
+    InstanceScript* instance = bot->GetInstanceScript();
+    return instance ? instance->GetCreature(dataId) : nullptr;
+}
+
+bool IsTwinsEncounterActive(Player* bot)
+{
+    if (!IsInAq40(bot))
+        return false;
+
+    InstanceScript* instance = bot->GetInstanceScript();
+    return instance && instance->GetBossState(AQT_DATA_TWIN_EMPERORS) == IN_PROGRESS;
+}
+
+TwinsSnapshot GetTwinsSnapshot(Player* bot)
+{
+    if (!IsInAq40(bot))
+        return TwinsSnapshot();
+
+    uint32 const instanceId = bot->GetMap()->GetInstanceId();
+    uint32 const now = getMSTime();
+    {
+        std::lock_guard<std::mutex> lock(twinsMutex);
+        auto it = twinsSnapshotByInstance.find(instanceId);
+        if (it != twinsSnapshotByInstance.end() &&
+            getMSTimeDiff(it->second.takenAtMs, now) < TWINS_SNAPSHOT_TTL_MS)
+        {
+            return it->second;
+        }
+    }
+
+    Creature* veklor = IsTwinsEncounterActive(bot) ? GetTwin(bot, AQT_DATA_VEKLOR) : nullptr;
+    Creature* veknilash = veklor ? GetTwin(bot, AQT_DATA_VEKNILASH) : nullptr;
+    if (!veklor || !veknilash || !veklor->IsAlive() || !veknilash->IsAlive())
+    {
+        std::lock_guard<std::mutex> lock(twinsMutex);
+        twinsSnapshotByInstance.erase(instanceId);
+        return TwinsSnapshot();
+    }
+
+    TwinsSnapshot snap;
+    snap.takenAtMs = now;
+    snap.valid = true;
+    snap.veklorGuid = veklor->GetGUID();
+    snap.veknilashGuid = veknilash->GetGUID();
+    // The only state the strategy needs: how far apart the twins are. The kite keys off it.
+    snap.separation = veklor->GetExactDist2d(veknilash);
+
+    std::lock_guard<std::mutex> lock(twinsMutex);
+    twinsSnapshotByInstance[instanceId] = snap;
+    return snap;
+}
+
+void TwinsEraseTrackers(Player* bot)
+{
+    if (!bot || !bot->GetMap())
+        return;
+
+    std::lock_guard<std::mutex> lock(twinsMutex);
+    twinsSnapshotByInstance.erase(bot->GetMap()->GetInstanceId());
+}
+
+namespace
+{
+    bool TwinsIsHealer(Player* member, PlayerbotAI* /*botAI*/)
+    {
+        // TwinsRankAmong takes bool(*)(Player*, PlayerbotAI*); PlayerbotAI::IsHeal is
+        // bool(*)(Player*, bool), which does NOT convert. Wrappers, not member pointers.
+        return member && PlayerbotAI::IsHeal(member);
+    }
+
+    bool TwinsIsWarlockTankCandidate(Player* member)
+    {
+        if (!member || PlayerbotAI::IsTank(member) || PlayerbotAI::IsHeal(member))
+            return false;
+
+        // Warlock first: Searing Pain carries spell_threat pctMod 2.0 and GetSpellThreatEntry
+        // falls back to GetFirstSpellInChain, so every rank doubles threat. That is what lets a
+        // cloth body hold a boss. Priest and mage are fallbacks with no such multiplier.
+        switch (member->getClass())
+        {
+            case CLASS_WARLOCK:
+            case CLASS_PRIEST:
+            case CLASS_MAGE:
+                return true;
+            default:
+                return false;
+        }
+    }
+
+    uint32 TwinsRankAmong(Player* bot, PlayerbotAI* botAI, bool (*wanted)(Player*, PlayerbotAI*))
+    {
+        Group* group = bot->GetGroup();
+        if (!group)
+            return 0;
+
+        // ONE pass. An O(n squared) role lookup here is ~10^6 member visits per world tick on a
+        // 40-man raid; that has shipped twice in this codebase. Do not nest this.
+        uint32 rank = 0;
+        for (GroupReference* ref = group->GetFirstMember(); ref; ref = ref->next())
+        {
+            Player* member = ref->GetSource();
+            if (!member || member == bot || !member->IsAlive() || !GET_PLAYERBOT_AI(member))
+                continue;
+            if (!wanted(member, botAI))
+                continue;
+            if (member->GetGUID() < bot->GetGUID())
+                ++rank;
+        }
+        return rank;
+    }
+
+    // Two of each tank, one pair per seat. Ranks 0 and 1 take seats A and B.
+    uint32 TwinsTankRank(Player* bot, bool warlock)
+    {
+        Group* group = bot->GetGroup();
+        if (!group)
+            return 0;
+
+        uint32 rank = 0;
+        for (GroupReference* ref = group->GetFirstMember(); ref; ref = ref->next())
+        {
+            Player* member = ref->GetSource();
+            if (!member || member == bot || !member->IsAlive() || !GET_PLAYERBOT_AI(member))
+                continue;
+            bool const isCandidate =
+                warlock ? TwinsIsWarlockTankCandidate(member) : PlayerbotAI::IsTank(member);
+            if (!isCandidate)
+                continue;
+            if (member->GetGUID() < bot->GetGUID())
+                ++rank;
+        }
+        return rank;
+    }
+}  // namespace
+
+bool IsTwinsPhysicalGroup(Player* member, PlayerbotAI* /*botAI*/)
+{
+    if (!member)
+        return false;
+
+    // By damage SCHOOL. Vek'nilash is immune to FIRE, NATURE, FROST, SHADOW and ARCANE
+    // (creature_immunities SchoolMask 124) and takes physical and Holy; Vek'lor is immune to
+    // physical only (SchoolMask 1). Hunters are physical despite being ranged; retribution
+    // paladins are physical despite Holy also landing on Vek'lor, because their output is weapon
+    // damage.
+    switch (member->getClass())
+    {
+        case CLASS_WARRIOR:
+        case CLASS_ROGUE:
+        case CLASS_HUNTER:
+        case CLASS_PALADIN:
+        case CLASS_DEATH_KNIGHT:
+            return true;
+        case CLASS_DRUID:
+        case CLASS_SHAMAN:
+            return PlayerbotAI::IsMelee(member);
+        default:
+            return false;
+    }
+}
+
+TwinsRole GetTwinsRole(Player* bot, PlayerbotAI* botAI)
+{
+    if (!bot || !botAI || !IsInAq40(bot))
+        return TwinsRole::None;
+
+    if (PlayerbotAI::IsHeal(bot))
+        return TwinsRole::Healer;
+
+    // Only the first two of each kind tank. Spares fall through to DPS rather than fighting the
+    // assigned pair for a position.
+    if (PlayerbotAI::IsTank(bot) && TwinsTankRank(bot, false) < 2)
+        return TwinsRole::WarriorTank;
+    if (TwinsIsWarlockTankCandidate(bot) && TwinsTankRank(bot, true) < 2)
+        return TwinsRole::WarlockTank;
+
+    return TwinsRole::Dps;
+}
+
+uint32 GetTwinsAssignedData(Player* bot, PlayerbotAI* botAI)
+{
+    switch (GetTwinsRole(bot, botAI))
+    {
+        case TwinsRole::WarriorTank:
+            return AQT_DATA_VEKNILASH;
+        case TwinsRole::WarlockTank:
+            return AQT_DATA_VEKLOR;
+        default:
+            return IsTwinsPhysicalGroup(bot, botAI) ? AQT_DATA_VEKNILASH : AQT_DATA_VEKLOR;
+    }
+}
+
+Creature* GetTwinsAssignedTwin(Player* bot, PlayerbotAI* botAI)
+{
+    return GetTwin(bot, GetTwinsAssignedData(bot, botAI));
+}
+
+// ---------------------------------------------------------------------------------------------
+// TANKS - boss-relative, no seats. Warriors own Vek'nilash (close to melee, hold, and the
+// separation action drags him off Vek'lor); warlocks own Vek'lor (hold from range where he stands).
+// Both twins are taunt-immune, so holding is pure threat, and nothing here depends on completing a
+// move inside any particular window.
+//
+// Threat sorts itself out. After a teleport each twin wipes threat and gives +2000 to
+// SelectNearestTarget(); whoever collects it, the tanks re-close and out-threat. Against Vek'lor the
+// warrior's threat is frozen at exactly 2000 (he deals zero damage to a physical-immune boss) and
+// Searing Pain doubles threat, so the warlock passes him in a handful of casts; on Vek'nilash the
+// warrior just out-damages it. That is the handoff the encounter is designed around; it needs no code.
+// ---------------------------------------------------------------------------------------------
+bool GetTwinsTankSpot(Player* bot, PlayerbotAI* botAI, Position& spot)
+{
+    if (!IsTwinsEncounterActive(bot))
+        return false;
+
+    TwinsSnapshot const snap = GetTwinsSnapshot(bot);
+    if (!snap.valid)
+        return false;
+
+    TwinsRole const role = GetTwinsRole(bot, botAI);
+    if (role != TwinsRole::WarriorTank && role != TwinsRole::WarlockTank)
+        return false;
+
+    Creature* veklor = GetTwin(bot, AQT_DATA_VEKLOR);
+    Creature* veknilash = GetTwin(bot, AQT_DATA_VEKNILASH);
+    if (!veklor || !veklor->IsAlive() || !veknilash || !veknilash->IsAlive())
+        return false;
+
+    // NO SEATS. Twin Teleport swaps the two bodies, but Vek'lor settles wherever he lands and holds
+    // (his 2.5s task stops him whenever a victim is within 45y), so the whole job is boss-relative:
+    // warlocks hold Vek'lor from range where he stands, warriors hold Vek'nilash and drag him off
+    // Vek'lor. The fixed-seat version oscillated the instant the twins got close - each tank's
+    // "which seat is my twin on" flickered tick to tick and no warrior ever settled into melee, so
+    // none held threat, so the kite never fired and the pair collapsed together.
+
+    // Warlock tank: Vek'lor is a caster held on Searing Pain from range, and he does not move.
+    // Native ranged movement parks the warlock in range on him; nothing to force here.
+    if (role == TwinsRole::WarlockTank)
+        return false;
+
+    // Warrior tank owns Vek'nilash. The KITE - dragging him away from Vek'lor - is the separation
+    // action (higher relevance; only his victim can lead him). Here we only keep the warrior in
+    // melee so it builds and holds threat: a warrior out of melee deals no damage, holds none, and
+    // Vek'nilash is taunt-immune. Close along the current bearing, then hand off to native tanking.
+    if (bot->GetExactDist2d(veknilash) <= TWINS_TANK_ENGAGE_RANGE + TWINS_STATION_TOLERANCE)
+        return false;
+
+    float const dx = bot->GetPositionX() - veknilash->GetPositionX();
+    float const dy = bot->GetPositionY() - veknilash->GetPositionY();
+    float const len = std::max(0.1f, std::hypot(dx, dy));
+    float x = veknilash->GetPositionX() + dx / len * TWINS_TANK_ENGAGE_RANGE;
+    float y = veknilash->GetPositionY() + dy / len * TWINS_TANK_ENGAGE_RANGE;
+    float z = bot->GetPositionZ();
+    bot->UpdateAllowedPositionZ(x, y, z);
+    spot.Relocate(x, y, z);
+    return true;
+}
+
+bool TwinsShouldMoveTank(Player* bot, PlayerbotAI* botAI)
+{
+    Position spot;
+    return GetTwinsTankSpot(bot, botAI, spot);
+}
+
+// ---------------------------------------------------------------------------------------------
+// HEALERS
+// ---------------------------------------------------------------------------------------------
+bool GetTwinsHealerSpot(Player* bot, PlayerbotAI* botAI, Position& spot)
+{
+    if (!IsTwinsEncounterActive(bot))
+        return false;
+
+    if (GetTwinsRole(bot, botAI) != TwinsRole::Healer)
+        return false;
+
+    // NO fixed zone. Split healers evenly between the twins by rank and ring each one around its
+    // assigned LIVE twin, FOLLOWING it as it moves - Vek'nilash is kited around, Vek'lor settles
+    // wherever he lands. Radius is outside Vek'nilash's melee and Vek'lor's ~11y Arcane Burst, and
+    // inside HealDistance (38.5y) of the tanks on that twin. This is the fix for healers charging off
+    // to the old fixed seat up the ramp when no boss was there.
+    uint32 const rank = TwinsRankAmong(bot, botAI, &TwinsIsHealer);
+    uint32 const bossData = (rank % 2 == 0) ? AQT_DATA_VEKNILASH : AQT_DATA_VEKLOR;
+    Creature* boss = GetTwin(bot, bossData);
+    if (!boss || !boss->IsAlive())
+        return false;
+
+    uint32 const slot = (rank / 2) % TWINS_HEALER_SLOTS;
+    float const bearing = float(slot) * 2.0f * float(M_PI) / float(TWINS_HEALER_SLOTS);
+    float x = boss->GetPositionX() + std::cos(bearing) * TWINS_HEALER_RADIUS;
+    float y = boss->GetPositionY() + std::sin(bearing) * TWINS_HEALER_RADIUS;
+    float z = boss->GetPositionZ();
+    bot->UpdateAllowedPositionZ(x, y, z);
+
+    if (bot->GetExactDist2d(x, y) <= TWINS_STATION_TOLERANCE)
+        return false;
+
+    spot.Relocate(x, y, z);
+    return true;
+}
+
+bool TwinsShouldHoldHealerSpot(Player* bot, PlayerbotAI* botAI)
+{
+    Position spot;
+    return GetTwinsHealerSpot(bot, botAI, spot);
+}
+
+// ---------------------------------------------------------------------------------------------
+// TARGETING
+// ---------------------------------------------------------------------------------------------
+Creature* FindTwinsMutatedBug(Player* bot)
+{
+    if (!IsTwinsEncounterActive(bot))
+        return nullptr;
+
+    // Searched FROM THE BOT: Cell::Visit clamps every radius to ~533y, so a search issued from a
+    // seat 95y away can silently return null.
+    std::list<Creature*> bugs;
+    std::vector<uint32> const entries = {NPC_QIRAJI_SCARAB, NPC_QIRAJI_SCORPION};
+    bot->GetCreatureListWithEntryInGrid(bugs, entries, TWINS_SEARCH_RANGE);
+
+    Creature* best = nullptr;
+    float bestDist = 0.0f;
+    for (Creature* bug : bugs)
+    {
+        if (!bug || !bug->IsAlive() || !bug->HasAura(SPELL_MUTATE_BUG))
+            continue;
+        float const d = bot->GetExactDist2d(bug);
+        if (!best || d < bestDist)
+        {
+            best = bug;
+            bestDist = d;
+        }
+    }
+    return best;
+}
+
+Unit* GetTwinsAttackTarget(Player* bot, PlayerbotAI* botAI)
+{
+    if (!IsTwinsEncounterActive(bot))
+        return nullptr;
+
+    TwinsRole const role = GetTwinsRole(bot, botAI);
+    if (role == TwinsRole::None || role == TwinsRole::Healer)
+        return nullptr;  // no opinion
+
+    // Mutated bugs first: +300% health and +1800% physical damage for 240s two-shots cloth.
+    if (Creature* bug = FindTwinsMutatedBug(bot))
+        return bug;
+
+    Creature* mine = GetTwinsAssignedTwin(bot, botAI);
+    if (!mine || !mine->IsAlive() || !bot->IsValidAttackTarget(mine))
+        return nullptr;
+
+    // No seats: every tank simply owns its twin and follows it - warriors chase Vek'nilash (and drag
+    // him off Vek'lor), warlocks stay on Vek'lor where he stands. Both warriors on Vek'nilash and
+    // both warlocks on Vek'lor is fine; more threat holds the boss faster, and there is no far seat
+    // to leave empty.
+    return mine;
+}
+
+bool IsTwinsHoldingFire(Player* bot, PlayerbotAI* botAI)
+{
+    if (!IsTwinsEncounterActive(bot))
+        return false;
+
+    TwinsRole const role = GetTwinsRole(bot, botAI);
+    if (role == TwinsRole::None || role == TwinsRole::Healer)
+        return false;
+
+    return GetTwinsAttackTarget(bot, botAI) == nullptr;
+}
+
+bool TwinsShouldRetarget(Player* bot, PlayerbotAI* botAI)
+{
+    Unit* want = GetTwinsAttackTarget(bot, botAI);
+    if (!want)
+    {
+        if (IsTwinsHoldingFire(bot, botAI))
+        {
+            LOG_DEBUG("playerbots", "[Aq40Twins] {} retarget HOLD sep {:.0f}", bot->GetName(),
+                      GetTwinsSnapshot(bot).separation);
+        }
+        return false;
+    }
+    return bot->GetVictim() != want;
+}
+
+// ---------------------------------------------------------------------------------------------
+// HAZARDS
+// ---------------------------------------------------------------------------------------------
+bool BuildTwinsEscapeSpot(Player* bot, float cx, float cy, float clearance, uint32 attempt,
+                          Position& spot)
+{
+    // The bearing snaps to fixed sectors so the destination is STABLE across ticks. A spot derived
+    // from the bot's own live position creeps a couple of yards per tick, and MoveTo's
+    // duplicate-destination guard then refuses every order, so the bot never leaves.
+    float const sector = 2.0f * float(M_PI) / float(TWINS_ESCAPE_SECTORS);
+    float away = std::atan2(bot->GetPositionY() - cy, bot->GetPositionX() - cx);
+    if (away < 0.0f)
+        away += 2.0f * float(M_PI);
+
+    int32 const stepped = int32(away / sector) + int32(attempt) * 4;
+    float const bearing = float(stepped % int32(TWINS_ESCAPE_SECTORS)) * sector;
+
+    float const radius = clearance + TWINS_STATION_TOLERANCE;
+    float x = cx + std::cos(bearing) * radius;
+    float y = cy + std::sin(bearing) * radius;
+    float z = bot->GetPositionZ();
+    bot->UpdateAllowedPositionZ(x, y, z);
+
+    if (bot->GetExactDist2d(x, y) <= TWINS_STATION_TOLERANCE)
+        return false;  // already clear: park rather than shuffle
+
+    spot.Relocate(x, y, z);
+    return true;
+}
+
+Creature* FindTwinsExplodingBug(Player* bot)
+{
+    if (!IsTwinsEncounterActive(bot))
+        return nullptr;
+
+    std::list<Creature*> bugs;
+    std::vector<uint32> const entries = {NPC_QIRAJI_SCARAB, NPC_QIRAJI_SCORPION};
+    bot->GetCreatureListWithEntryInGrid(bugs, entries, TWINS_SEARCH_RANGE);
+
+    Creature* nearest = nullptr;
+    float nearestDist = 0.0f;
+    for (Creature* bug : bugs)
+    {
+        if (!bug || !bug->IsAlive() || !bug->HasAura(SPELL_EXPLODE_BUG))
+            continue;
+        float const d = bot->GetExactDist2d(bug);
+        if (!nearest || d < nearestDist)
+        {
+            nearest = bug;
+            nearestDist = d;
+        }
+    }
+    return nearest;
+}
+
+bool TwinsShouldClearExplode(Player* bot, PlayerbotAI* /*botAI*/)
+{
+    Creature* bug = FindTwinsExplodingBug(bot);
+    // 804 is a 3s fuse, then 26059 for ~3000 fire in 15y. The bug is hostile and moving, which is
+    // why the destination is stabilised by the sector snap rather than by freezing the centre.
+    return bug && bot->GetExactDist2d(bug) < TWINS_EXPLODE_RADIUS + TWINS_STATION_TOLERANCE;
+}
+
+bool GetTwinsExplodeClearSpot(Player* bot, Position& spot, uint32 attempt)
+{
+    Creature* bug = FindTwinsExplodingBug(bot);
+    if (!bug)
+        return false;
+
+    return BuildTwinsEscapeSpot(bot, bug->GetPositionX(), bug->GetPositionY(),
+                                TWINS_EXPLODE_RADIUS, attempt, spot);
+}
+
+bool GetTwinsBlizzardCenter(Player* bot, Position& center)
+{
+    Creature* veklor = GetTwin(bot, AQT_DATA_VEKLOR);
+    if (!veklor)
+        return false;
+
+    // 26607's effect 0 is a PERSISTENT_AREA_AURA, so the live patch is a DynamicObject owned by
+    // its caster. It lands on a random raid member, NOT on Vek'lor, so the dynobject's own
+    // position is the only source of truth.
+    DynamicObject* patch = veklor->GetDynObject(SPELL_BLIZZARD);
+    if (!patch)
+        return false;
+
+    center.Relocate(patch->GetPositionX(), patch->GetPositionY(), patch->GetPositionZ());
+    return true;
+}
+
+bool TwinsShouldClearBlizzard(Player* bot, PlayerbotAI* /*botAI*/)
+{
+    if (!IsTwinsEncounterActive(bot))
+        return false;
+
+    Position center;
+    if (!GetTwinsBlizzardCenter(bot, center))
+        return false;
+
+    return bot->GetExactDist2d(center.GetPositionX(), center.GetPositionY()) <
+           TWINS_BLIZZARD_RADIUS + TWINS_STATION_TOLERANCE;
+}
+
+bool GetTwinsBlizzardClearSpot(Player* bot, Position& spot, uint32 attempt)
+{
+    Position center;
+    if (!GetTwinsBlizzardCenter(bot, center))
+        return false;
+
+    // Clearance is the patch radius, so the escape can never land back inside the same patch.
+    return BuildTwinsEscapeSpot(bot, center.GetPositionX(), center.GetPositionY(),
+                                TWINS_BLIZZARD_RADIUS, attempt, spot);
+}
+
+// ---------------------------------------------------------------------------------------------
+// KITE. The whole separation mechanic: the warriors drag Vek'nilash straight away from Vek'lor to
+// keep the twins past the 69y Heal Brother gate. Vek'nilash is the only thing that needs moving -
+// Vek'lor settles wherever he lands and holds - and BOTH warriors do it, not just the one he is
+// chasing, so he keeps moving off Vek'lor regardless of which warrior holds aggro.
+// ---------------------------------------------------------------------------------------------
+bool TwinsShouldFixSeparation(Player* bot, PlayerbotAI* botAI)
+{
+    if (!IsTwinsEncounterActive(bot))
+        return false;
+
+    TwinsSnapshot const snap = GetTwinsSnapshot(bot);
+    if (!snap.valid || snap.separation >= TWINS_SEPARATION_GUARD)
+        return false;
+
+    Creature* veknilash = GetTwin(bot, AQT_DATA_VEKNILASH);
+    if (!veknilash || !veknilash->IsAlive())
+        return false;
+
+    // Whoever Vek'nilash is actually chasing MUST kite him - only his victim can lead him, and if
+    // that bot (the main tank, the OFF tank, or a DPS that pulled a threat bounce) just stands there,
+    // he sits right on top of Vek'lor. That is the "one tank kited, the other didn't" we saw: the
+    // off tank held aggro but never moved him. On top of that, ANY warrior tank already in melee
+    // kites too, so the two designated tanks drag him out together instead of it falling to one.
+    bool const iAmVictim = veknilash->GetVictim() == bot;
+    bool const iAmEngagedWarrior =
+        GetTwinsRole(bot, botAI) == TwinsRole::WarriorTank &&
+        bot->GetExactDist2d(veknilash) <= TWINS_TANK_ENGAGE_RANGE + TWINS_STATION_TOLERANCE;
+    if (!iAmVictim && !iAmEngagedWarrior)
+        return false;
+
+    // Hazards outrank this, and their own predicates do not stand down for it.
+    return !TwinsShouldClearExplode(bot, botAI) && !TwinsShouldClearBlizzard(bot, botAI);
+}
+
+bool GetTwinsSeparationSpot(Player* bot, PlayerbotAI* /*botAI*/, Position& spot)
+{
+    TwinsSnapshot const snap = GetTwinsSnapshot(bot);
+    if (!snap.valid)
+        return false;
+
+    Creature* veklor = GetTwin(bot, AQT_DATA_VEKLOR);
+    Creature* veknilash = GetTwin(bot, AQT_DATA_VEKNILASH);
+    if (!veklor || !veknilash)
+        return false;
+
+    // Kite straight away from Vek'lor, along the Vek'lor -> Vek'nilash line, out past Vek'nilash to
+    // ~95y+ from Vek'lor. Both warriors aim at the SAME relative point - not a fixed zone - so
+    // whoever holds aggro drags Vek'nilash the same way and the other follows. Snap the bearing so
+    // the destination is stable and MoveTo's duplicate-destination guard does not refuse it.
+    float const sector = 2.0f * float(M_PI) / float(TWINS_ESCAPE_SECTORS);
+    float bearing = std::atan2(veknilash->GetPositionY() - veklor->GetPositionY(),
+                               veknilash->GetPositionX() - veklor->GetPositionX());
+    if (bearing < 0.0f)
+        bearing += 2.0f * float(M_PI);
+    bearing = float(int32(bearing / sector)) * sector;
+
+    float const radius = TWINS_SEAT_SEPARATION + TWINS_TANK_ENGAGE_RANGE;  // ~100y: Vek'nilash drags to ~95
+    float x = veklor->GetPositionX() + std::cos(bearing) * radius;
+    float y = veklor->GetPositionY() + std::sin(bearing) * radius;
+    float z = bot->GetPositionZ();
+    bot->UpdateAllowedPositionZ(x, y, z);
+
+    LOG_DEBUG("playerbots", "[Aq40Twins] {} kite sep {:.0f} < {:.0f}, driving Veknilash out",
+              bot->GetName(), snap.separation, TWINS_SEPARATION_GUARD);
+    spot.Relocate(x, y, z);
+    return true;
+}
+
+// ---------------------------------------------------------------------------------------------
+// PETS
+// ---------------------------------------------------------------------------------------------
+bool TwinsShouldDirectPet(Player* bot, PlayerbotAI* /*botAI*/)
+{
+    if (!IsTwinsEncounterActive(bot))
+        return false;
+
+    return bot->GetPet() || !bot->m_Controlled.empty();
+}
+
+bool TwinsShouldSuppressGenericMovement(Player* bot, PlayerbotAI* botAI)
+{
+    if (!IsTwinsEncounterActive(bot))
+        return false;
+
+    // ONE predicate, shared with the movement multiplier, so the veto and the moves cannot
+    // disagree about whether a move is owed. Note what is NOT here: DPS. Their assigned twin is
+    // their target and native movement walks them to it, across the room if need be - so generic
+    // movement is exactly what we want for them and must never be vetoed.
+    if (TwinsShouldClearExplode(bot, botAI) || TwinsShouldClearBlizzard(bot, botAI))
+        return true;
+
+    if (TwinsShouldFixSeparation(bot, botAI))
+        return true;
+
+    return TwinsShouldMoveTank(bot, botAI) || TwinsShouldHoldHealerSpot(bot, botAI);
+}
+
+}  // namespace TempleOfAhnQirajHelpers
