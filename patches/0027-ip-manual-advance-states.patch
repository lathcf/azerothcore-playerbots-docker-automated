+// Patch 0027: parse "8 13" or "8,13" into manualAdvanceStates. Out-of-range tokens are dropped.
+void IndividualProgression::LoadManualAdvanceStates(std::string const& list)
+{
+    manualAdvanceStates.clear();
+    std::string normalized = list;
+    for (char& c : normalized)
+        if (c == ',')
+            c = ' ';
+    std::stringstream ss(normalized);
+    uint32 value;
+    while (ss >> value)
+        if (value >= PROGRESSION_MOLTEN_CORE && value <= PROGRESSION_WOTLK_TIER_5)
+            manualAdvanceStates.insert(static_cast<uint8>(value));
+}
+
+// Patch 0027: an AUTOMATIC advance may not cross into a held state; it lands at (held - 1).
+// std::set iterates ascending, so the first held state above the player's current state wins.
+ProgressionState IndividualProgression::ClampHeldAdvance(Player* player, ProgressionState newState) const
+{
+    if (manualAdvanceStates.empty() || !player)
+        return newState;
+
+    uint8 currentState = GetPlayerProgressionFromQuests(player);
+    for (uint8 held : manualAdvanceStates)
+    {
+        if (currentState < held && newState >= held)
+        {
+            ProgressionState clamped = static_cast<ProgressionState>(held - 1);
+            LOG_INFO("module", "[IP] manual-advance hold: {} auto-advance to {} clamped to {} (advance via the faction leader)",
+                player->GetName(), uint32(newState), uint32(clamped));
+            return clamped;
+        }
+    }
+    return newState;
+}
