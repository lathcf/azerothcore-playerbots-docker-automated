diff --git a/src/server/game/Spells/Auras/SpellAuraEffects.cpp b/src/server/game/Spells/Auras/SpellAuraEffects.cpp
index 8a4b34da..d5c9f5ee 100644
--- a/src/server/game/Spells/Auras/SpellAuraEffects.cpp
+++ b/src/server/game/Spells/Auras/SpellAuraEffects.cpp
@@ -1518,6 +1518,23 @@ void AuraEffect::HandleShapeshiftBoosts(Unit* target, bool apply) const
                     {
                         int32 HotWMod = (*i)->GetAmount() / 2; // For each 2% Intelligence, you get 1% stamina and 1% attack power.
 
+                        // era-talents patch 0023: TBC's Heart of the Wild gives Bear/Dire Bear Stamina equal to the
+                        // FULL Intellect percentage (4/8/12/16/20%), not half of it — the halving above is WotLK's
+                        // retune, and it is computed here in core rather than in the spell data, so it is invisible
+                        // to the spell-diff pipeline the era datasets are built from. The talent's own tooltip
+                        // therefore promised 20% while runtime delivered 10%. We cannot fix this in data: the bonus
+                        // is derived from the Intellect aura's amount, and the stat auras are stock global spells
+                        // while eras are per-character. A second stance-gated top-up aura cannot land the exact
+                        // numbers either, because SPELL_AURA_MOD_TOTAL_STAT_PERCENTAGE auras combine
+                        // MULTIPLICATIVELY (Unit::GetTotalAuraMultiplier -> AddPct), so 10% + 9% = 19.9%, not 20%.
+                        // So mod-era-talents grants the hidden marker aura 946280 (SPELL_AURA_DUMMY, misc 18) to a
+                        // TBC-era druid who has the talent, and we skip the halving for the BEAR spell only.
+                        // Cat (24900) keeps the halved value — TBC's cat attack power really is 2/4/6/8/10%.
+                        // Inert for every unmarked druid, so Vanilla-era and native WotLK druids are untouched
+                        // (Vanilla's own tooltip states the halved 2/4/6/8/10% and is already correct).
+                        if (HotWSpellId == 24899 && target->HasAura(946280 /*ERA_TBC_HOTW_MARKER, misc 18*/))
+                            HotWMod = (*i)->GetAmount();
+
                         target->CastCustomSpell(target, HotWSpellId, &HotWMod, nullptr, nullptr, true, nullptr, this, target->GetGUID());
                         break;
                     }
